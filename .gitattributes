# Trellis: append-only developer journals should merge cleanly across
# parallel sessions/worktrees. Each session appends a new block, so there is
# normally no conflicting edit to resolve.
#
# Do NOT add a rule for workspace/*/index.md: it is regenerated by sessions.
# Task state is stored in task.json; resolve a real index conflict by choosing
# either side after confirming the task metadata is intact.
.trellis/workspace/*/journal-*.md merge=union
