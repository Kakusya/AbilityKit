+function Get-GateProjectClosure {
+    param([string]$Project,[string]$Configuration,[string]$NodeRoot)
+    $visited=@{};$queue=New-Object 'System.Collections.Generic.Queue[string]';$queue.Enqueue([IO.Path]::GetFullPath($Project));$items=@()
