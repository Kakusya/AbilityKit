+        for($i=0;$i -lt $manifest.binaries.Count;$i++){if(($entries[$i]|ConvertTo-Json -Compress) -ne ($manifest.binaries[$i]|ConvertTo-Json -Compress)){throw 'Consumer binary capture contradiction.'}}
