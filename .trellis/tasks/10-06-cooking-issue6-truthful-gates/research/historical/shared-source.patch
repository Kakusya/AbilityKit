+            $bound=$boundImmutable[$input.path]
+            $exactBound=$null -ne $bound -and $bound.sha256 -eq $input.sha256
+            if($exactBound){foreach($field in @('root','role','path','bytes','sha256','producerRunId','producerResultId')){if($bound.artifact.$field -cne $input.artifact.$field){$exactBound=$false;break}}}
+            $null=Assert-GateBuildArtifact $input.artifact $BuildRoot $input.artifact.producerRunId $owner -AllowBoundImmutableInput:$exactBound
+            if($input.sha256 -ne $input.artifact.sha256){throw 'Stage input hash mismatch.'}
+        }
+    }
+    $bundle=Get-GateRestoreBundle $Manifest $BuildRoot $RepoRoot $ExpectedClosure -AllowExample:$AllowExample
+    $expected=@($Manifest.immutableInputs)+@(foreach($asset in $bundle.assets){[pscustomobject]@{path=$asset.logicalPath;sha256=$asset.sha256}})
+    if((Get-GateFingerprint $expected) -ne $Manifest.build.inputBeforeSha256){throw 'Stale restored build inputs.'}
+    if(-not $RestoreOnly){
+        if(-not @($Manifest.binaries).Count){throw 'Binary manifest empty.'}
+        $mapPath=Join-Path $BuildRoot 'binary-path-map.json'
+        if(-not (Test-Path -LiteralPath $mapPath -PathType Leaf)){throw 'Binary path map absent.'}
+        $map=Get-Content -LiteralPath $mapPath -Raw|ConvertFrom-Json
+        if(@($map).Count -ne @($Manifest.binaries).Count){throw 'Binary map closure contradiction.'}
+        for($i=0;$i -lt $Manifest.binaries.Count;$i++){
+            $artifact=$Manifest.binaries[$i];$null=Assert-GateBuildArtifact $artifact $BuildRoot $Manifest.build.producerRunId $Manifest.build.producerResultId
+            if($artifact.sha256 -ne $map[$i].sha256){throw 'Binary map identity mismatch.'}
+        }
+        Assert-GateFileSet $map $RepoRoot
+    }
+    $stagePath=Join-Path $BuildRoot 'stage-invocations.json'
+    if(-not (Test-Path -LiteralPath $stagePath -PathType Leaf)){throw 'Stage invocation receipt absent.'}
+    $times=Get-Content -LiteralPath $stagePath -Raw|ConvertFrom-Json
+    if($times.restore.processExitCode -ne 0 -or $times.build.processExitCode -ne 0 -or [DateTimeOffset]$times.build.startedAt -lt [DateTimeOffset]$times.restore.endedAt){throw 'Stage order/native exit contradiction.'}
+    if(($times.restore.command|ConvertTo-Json -Depth 12 -Compress) -cne ($Manifest.restore.command|ConvertTo-Json -Depth 12 -Compress) -or ($times.build.command|ConvertTo-Json -Depth 12 -Compress) -cne ($Manifest.build.command|ConvertTo-Json -Depth 12 -Compress)){throw 'Stage invocation/manifest command contradiction.'}
+}
