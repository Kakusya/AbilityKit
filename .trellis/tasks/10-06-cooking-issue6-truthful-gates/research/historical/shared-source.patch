+function Assert-GateTests {
+    param($Tests)
+    if($null -eq $Tests -or -not $Tests.declared){throw 'Declared tests absent.'}
+    foreach($key in @('total','resultEntries','executed','passed','failed','skipped','notExecuted')){if(($Tests.$key -isnot [int] -and $Tests.$key -isnot [long]) -or $Tests.$key -lt 0){throw 'Invalid test count.'}}
