+function Complete-GateProducer {
+    param([int]$NativeExitCode=0,[string]$Reason,[ValidateSet('Passed','Failed','Blocked')][string]$Status)
+    if(-not $script:GateProducer){return $NativeExitCode}
+    $producer=$script:GateProducer
+    if($producer.completed){return $producer.result.cliExitCode}
+    $result=$producer.result;$context=$producer.context
+    $result.processExitCode=$NativeExitCode;$result.executionEndedAt=[DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')
+    if(-not $Status){$Status=$(if($NativeExitCode -eq 0){'Passed'}else{'Failed'})}
+    try {
+        if($producer.inputs.Count){
+            $inputs=@($producer.inputs.Values|Sort-Object path)
+            foreach($input in $inputs){
+                if((Get-GateHash $input.path -AllowEmptyImmutableInput) -ne $input.sha256){throw 'Producer input changed during body.'}
+                $null=Assert-GateBuildArtifact $input.artifact $context.nodeRoot $result.runId $result.resultId -AllowBoundImmutableInput
+            }
+            $inputManifest=Join-Path $context.nodeRoot 'producer-inputs.json'
+            ConvertTo-Json -InputObject $inputs -Depth 12|Set-Content $inputManifest -Encoding UTF8
+            Add-GateArtifact $result $context.runRoot $inputManifest 'producer-inputs'
+        }
+        $after=Get-GateSource $context.repoRoot;$result.source.inputManifestAfterSha256=$after.inputManifestSha256;Assert-GateSource $context.source $after
+        if($script:GateAssertions -gt 0){
+            $assertionPath=Join-Path $context.nodeRoot 'assertions.json'
+            ConvertTo-Json -InputObject @($script:GateAssertionEntries.ToArray()) -Depth 12|Set-Content $assertionPath -Encoding UTF8
+            Add-GateArtifact $result $context.runRoot $assertionPath $(if($context.evidenceType -eq 'assertions'){'assertions'}else{'audit-assertions'})
+            if($context.evidenceType -eq 'assertions'){$result.tests=Get-GateAssertionCounts $assertionPath}
+        }
+        if($Status -eq 'Passed'){
+            if($context.evidenceType -in @('assertions','audit') -and $script:GateAssertions -le 0){throw 'Producer reported no actual criteria entries.'}
+            if($context.evidenceType -eq 'assertions'){Assert-GateTests $result.tests}
+            elseif($context.evidenceType -eq 'audit'){Assert-GateTests (Get-GateAssertionCounts $assertionPath)}
+            Assert-GateProducerEvidence $result $context
+        }
+        $completionPath=Join-Path $context.nodeRoot 'completion.json'
+        @{script=$producer.scriptPath;nativeExit=$NativeExitCode;criteriaCompleted=($Status -eq 'Passed');assertions=$script:GateAssertions;source=$result.source}|ConvertTo-Json -Depth 8|Set-Content $completionPath -Encoding UTF8
+        Add-GateArtifact $result $context.runRoot $completionPath 'producer-completion'
+        Set-GateTerminal $result $Status $Reason
+    }catch{Set-GateTerminal $result 'Failed' $_.Exception.Message}
+    $result.endedAt=[DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')
+    $result|ConvertTo-Json -Depth 80|Set-Content -LiteralPath $producer.resultPath -Encoding UTF8
+    $producer.completed=$true
+    return $result.cliExitCode
+}
