+    foreach ($part in $RelativePath.Split('/')) {
+        if ($part -eq '' -or $part -in @('.', '..') -or $part -match '[ .]$|^(?i:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\.|$)') { throw 'Unsafe artifact component.' }
+    }
+    $base = [IO.Path]::GetFullPath($Root).TrimEnd('\','/')
+    $current = $base
+    $ancestor=$base
+    while($ancestor){
+        if((Test-Path -LiteralPath $ancestor) -and ((Get-Item -LiteralPath $ancestor -Force).Attributes -band [IO.FileAttributes]::ReparsePoint)){throw 'Reparse artifact root/ancestor.'}
+        $parent=[IO.Directory]::GetParent($ancestor);$ancestor=$(if($parent){$parent.FullName}else{$null})
+    }
+    foreach ($part in $RelativePath.Split('/')) {
+        $current = Join-Path $current $part
