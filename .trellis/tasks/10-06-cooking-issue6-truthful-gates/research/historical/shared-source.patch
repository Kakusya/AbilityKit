+function Add-GateArtifact {
+    param($Result,[string]$RunRoot,[string]$Path,[string]$Role)
+    $base=[IO.Path]::GetFullPath($RunRoot).TrimEnd('\','/') + [IO.Path]::DirectorySeparatorChar
+    $full=[IO.Path]::GetFullPath($Path)
+    if(-not $full.StartsWith($base,[StringComparison]::OrdinalIgnoreCase)){ throw 'Artifact outside run root.' }
+    $ownedRoot=Join-Path $RunRoot $Result.resultId
+    $ownedBase=[IO.Path]::GetFullPath($ownedRoot).TrimEnd('\','/')+[IO.Path]::DirectorySeparatorChar
+    if(-not $full.StartsWith($ownedBase,[StringComparison]::OrdinalIgnoreCase)){throw 'Artifact owned by another node.'}
+    $relative=$full.Substring($ownedBase.Length).Replace('\','/')
+    $null=Resolve-GateArtifact $ownedRoot $relative
+    $Result.artifacts += [pscustomobject]@{root='run-step';path=$relative;bytes=(Get-Item -LiteralPath $full).Length;sha256=Get-GateHash $full;role=$Role;producerRunId=$Result.runId;producerResultId=$Result.resultId}
+}
