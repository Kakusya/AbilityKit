+    if($Tests.total -le 0 -or $Tests.executed -le 0 -or $Tests.failed -gt 0 -or $Tests.skipped -gt 0 -or $Tests.notExecuted -gt 0){throw 'Declared test coverage incomplete or failed.'}
+}
