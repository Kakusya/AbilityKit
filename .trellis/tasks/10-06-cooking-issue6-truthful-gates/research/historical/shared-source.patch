+function Merge-GateResults {
+    param($GateResult,[object[]]$Children,[bool]$SourceChanged=$false)
+    $GateResult.steps=@($Children);$completed=@();$bindings=@{}
+    foreach($child in $Children){foreach($token in $child.coverage.completed){$completed+=$token; $bindings[$token]=@($bindings[$token])+@(Get-GateBindingIds $child.coverage.bindings $token)}}
