+function Assert-GateRawReportBinding {
+    param($Result,[string]$Path,[string]$Format)
+    [xml]$xml=Get-Content -LiteralPath $Path -Raw
+    if($Format -eq 'trx'){
+        $times=$xml.SelectSingleNode("/*[local-name()='TestRun']/*[local-name()='Times']")
+        if($null -eq $times -or -not $times.start -or -not $times.finish){throw 'TRX invocation times absent.'}
+        $start=[DateTimeOffset]$times.start;$end=[DateTimeOffset]$times.finish
+        $summary=$xml.SelectSingleNode("/*[local-name()='TestRun']/*[local-name()='ResultSummary']")
+        if($summary.outcome -notin @('Completed','Passed')){throw 'TRX overall result rejected.'}
+        if(-not $script:GateBuildValidation -or -not $script:GateBuildValidation.ContainsKey($Result.resultId)){throw 'TRX trusted binary context absent.'}
+        $context=$script:GateBuildValidation[$Result.resultId]
+        $target=@($context.closure|Where-Object{$_.project -eq $context.project})
+        if($target.Count -ne 1){throw 'Ambiguous test assembly target.'}
+        $targetPath=[IO.Path]::GetFullPath($target[0].targetPath)
+        $definitions=@{};$nodes=@($xml.SelectNodes("/*[local-name()='TestRun']/*[local-name()='TestDefinitions']/*[local-name()='UnitTest']"))
+        foreach($node in $nodes){
+            $id=[string]$node.id;if(-not $id -or $definitions.ContainsKey($id)){throw 'Duplicate/absent TRX definition.'}
+            $definitions[$id]=$node
+        }
+        foreach($entry in $xml.SelectNodes("/*[local-name()='TestRun']/*[local-name()='Results']/*[local-name()='UnitTestResult']")){
+            if(-not $definitions.ContainsKey([string]$entry.testId)){throw 'TRX entry lacks assembly definition.'}
+            $definition=$definitions[[string]$entry.testId]
+            foreach($location in @([string]$definition.storage,[string]$definition.TestMethod.codeBase)){
+                if(-not $location){throw 'TRX assembly identity absent.'}
+                $resolved=$(if([IO.Path]::IsPathRooted($location)){[IO.Path]::GetFullPath($location)}else{[IO.Path]::GetFullPath((Join-Path (Split-Path $targetPath) $location))})
+                if(-not $resolved.Equals($targetPath,[StringComparison]::OrdinalIgnoreCase)){throw 'TRX bound to wrong test assembly.'}
+            }
+        }
+    }else{
+        $root=$xml.DocumentElement
+        if($root.result -ne 'Passed' -or -not $root.'start-time' -or -not $root.'end-time'){throw 'NUnit overall result or invocation times invalid.'}
+        $start=[DateTimeOffset]$root.'start-time';$end=[DateTimeOffset]$root.'end-time'
+    }
+    # Canonical times have second precision; raw producer timestamps retain fractions.
+    if($start -lt [DateTimeOffset]$Result.executionStartedAt -or $end -lt $start -or $end -gt ([DateTimeOffset]$Result.executionEndedAt).AddSeconds(1)){throw 'Old/out-of-invocation test report.'}
+}
