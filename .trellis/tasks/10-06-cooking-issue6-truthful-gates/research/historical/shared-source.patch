+function Assert-GateProducerDeclaration {
+    param($Step,[object[]]$EarlierSteps=@())
+    if($Step.kind -ne 'powershell-script'){return}
+    $contract=Get-GateProducerContract ([string]$Step.script)
+    $declared=$Step.PSObject.Properties['evidenceType']
+    if($contract -and (-not $declared -or [string]$declared.Value -cne $contract.evidenceType)){throw 'Configured producer evidence contract missing or contradictory.'}
+    if($declared -and [string]$declared.Value -notin @('audit','assertions','report','build','receipt','measurement','thresholds')){throw 'Unsupported configured producer evidence type.'}
+    $predecessors=@();if($Step.PSObject.Properties['predecessors']){$predecessors=@($Step.predecessors)}
+    $roles=@($predecessors|ForEach-Object{$_.role})
+    if(@($roles|Sort-Object -Unique).Count -ne $roles.Count){throw 'Duplicate configured predecessor role.'}
+    if($contract -and ((@($roles|Sort-Object) -join '|') -cne (@($contract.roles|Sort-Object) -join '|'))){throw 'Configured producer predecessor roles missing or contradictory.'}
+    foreach($edge in $predecessors){
+        if(-not $edge.sourceStep -or -not $edge.role -or @($edge.PSObject.Properties.Name|Where-Object{$_ -notin @('sourceStep','role')}).Count){throw 'Invalid configured predecessor declaration.'}
+        $sources=@($EarlierSteps|Where-Object{$_.name -ceq $edge.sourceStep})
+        if($sources.Count -ne 1 -or $sources[0].kind -cne 'powershell-script'){throw 'Configured predecessor source step missing or ambiguous.'}
+        # Validate actual output roles of the declared source adapter, not any sibling.
+        $expectedScript=switch($edge.role){'content-report'{'tools/build_moba_content_report.ps1'};{$_ -in @('content-ir','content-diagnostics')}{'tools/export_moba_content_ir.ps1'};default{$null}}
+        $root=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
+        $sourcePath=[IO.Path]::GetFullPath($(if([IO.Path]::IsPathRooted($sources[0].script)){$sources[0].script}else{Join-Path $root $sources[0].script}))
+        if(-not $expectedScript -or $sourcePath -ine [IO.Path]::GetFullPath((Join-Path $root $expectedScript))){throw 'Configured predecessor source/role mismatch.'}
+    }
+    if($contract -and $contract.project){
+        if(-not $Step.PSObject.Properties['provenanceProject'] -or $Step.provenanceProject -cne $contract.project){throw 'Configured producer provenance project missing or contradictory.'}
+        if($Step.PSObject.Properties['buildManifestStep']){
+            $sources=@($EarlierSteps|Where-Object{$_.name -ceq $Step.buildManifestStep})
+            if($sources.Count -ne 1 -or $sources[0].kind -cne 'dotnet-build' -or $sources[0].project -cne $Step.provenanceProject){throw 'Configured build manifest predecessor mismatch.'}
+        }
+    }elseif($Step.PSObject.Properties['provenanceProject'] -or $Step.PSObject.Properties['buildManifestStep']){throw 'Undeclared producer provenance contract.'}
+}
