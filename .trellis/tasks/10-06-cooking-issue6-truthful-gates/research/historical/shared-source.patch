+# Child process execution seam. Fixtures replace only the executor, never the body.
+function Invoke-GateProducerCommand {
+    param([string]$Executable,[string[]]$Arguments)
+    if(-not $script:GateProducer){
+        & $Executable @Arguments 2>&1
+        $global:LASTEXITCODE=$LASTEXITCODE
+        return
+    }
+    $producer=$script:GateProducer
+    if($producer.context.example -and -not $script:GateNativeExecutor){throw 'Fixture invocation requires an installed executor before native work.'}
+    $index=@($producer.result.artifacts|Where-Object{$_.role -eq 'native-invocation'}).Count
+    $log=Join-Path $producer.context.nodeRoot ('native-'+$index+'.log')
+    $call=$(if($script:GateNativeExecutor){& $script:GateNativeExecutor $Executable $Arguments $log}else{Invoke-GateNative $Executable $Arguments $log})
+    if($null -eq $call.processExitCode){throw 'Native executor omitted exit code.'}
+    $receipt=Join-Path $producer.context.nodeRoot ('native-'+$index+'.json')
+    $call|ConvertTo-Json -Depth 12|Set-Content $receipt -Encoding UTF8
+    Add-GateArtifact $producer.result $producer.context.runRoot $receipt 'native-invocation'
+    if((Test-Path -LiteralPath $log) -and (Get-Item -LiteralPath $log).Length){Add-GateArtifact $producer.result $producer.context.runRoot $log 'native-log'}
+    $global:LASTEXITCODE=[int]$call.processExitCode
+    if(Test-Path -LiteralPath $log){Get-Content -LiteralPath $log -Encoding UTF8}
+}
