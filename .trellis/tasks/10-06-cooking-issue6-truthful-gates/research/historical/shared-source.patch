+function Get-GatePredecessorPath {
+    param([string]$Role)
+    $producer=$script:GateProducer
+    $entries=@($producer.context.predecessors|Where-Object{$_.role -eq $Role})
+    if($entries.Count -ne 1){throw "Exact predecessor missing: $Role"}
+    $entry=$entries[0];$artifact=$entry.artifact
+    if($entry.result.runId -ne $producer.result.runId -or $entry.result.status -ne 'Passed' -or $artifact.producerRunId -ne $entry.result.runId -or $artifact.producerResultId -ne $entry.result.resultId){throw 'Predecessor owner/status mismatch.'}
+    $path=Resolve-GateArtifact (Join-Path $producer.context.runRoot $entry.result.resultId) $artifact.path
+    if($artifact.root -ne 'run-step' -or $artifact.role -ne $Role -or (Get-GateHash $path) -ne $artifact.sha256 -or (Get-Item -LiteralPath $path).Length -ne $artifact.bytes){throw 'Predecessor bytes mismatch.'}
+    return $path
+}
