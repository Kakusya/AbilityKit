+}
+Check 'zero-test-coverage' {$v=Copy-Result $leaf;foreach($key in @('total','executed','resultEntries','passed')){$v.tests.$key=0};Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'wrong-artifact-owner' {$v=Copy-Result $leaf;$v.artifacts[0].producerResultId=[guid]::NewGuid().ToString();Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'artifact-hash' {$v=Copy-Result $leaf;$v.artifacts[0].sha256='d'*64;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'artifact-size' {$v=Copy-Result $leaf;$v.artifacts[0].bytes++;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'leaf-binding-wrong-id' {$v=Copy-Result $leaf;$v.coverage.bindings.'tests:fixture'=@([guid]::NewGuid().ToString());Reject {Assert-GateResult $v $ArtifactRoot}}
+foreach($path in @('../old.txt','x/../old.txt','x\old.txt','C:/old.txt','//host/path','x:stream','CON.txt','x/NUL','x/COM1.log','x/end.','x/end ','x//file','/root','x/./file','x/a b.txt','x/thing?')){
+    Check "unsafe-path:$path" {Reject {Resolve-GateArtifact $ArtifactRoot $path}}
+}
+Check 'safe-slash-path' {Require ((Resolve-GateArtifact $ArtifactRoot ($leaf.resultId+'/report.txt')) -eq (Join-Path $node 'report.txt')) 'Safe path did not resolve.'}
+function Write-Trx([string]$Name,[string]$Outcome,[int]$Total=1,[int]$Passed=0,[int]$Failed=0){
+    $path=Join-Path $ArtifactRoot ($Name+'.trx')
+    "<TestRun xmlns='http://microsoft.com/schemas/VisualStudio/TeamTest/2010'><Results><UnitTestResult executionId='1' outcome='$Outcome'/></Results><ResultSummary><Counters total='$Total' executed='1' passed='$Passed' failed='$Failed'/></ResultSummary></TestRun>"|Set-Content $path -Encoding UTF8
+    return $path
+}
+Check 'trx-valid' {$counts=Get-GateTestCounts (Write-Trx 'passed' 'Passed' 1 1 0) 'trx';Assert-GateTests $counts}
+Check 'trx-failed-native0' {$counts=Get-GateTestCounts (Write-Trx 'failed-native0' 'Failed' 1 0 1) 'trx';Reject {Assert-GateTests $counts}}
+Check 'trx-total-contradiction-native0' {Reject {Get-GateTestCounts (Write-Trx 'bad-total' 'Passed' 2 1 0) 'trx'}}
+Check 'trx-outcome-counter-contradiction' {Reject {Get-GateTestCounts (Write-Trx 'bad-failed' 'Failed' 1 1 0) 'trx'}}
+Check 'trx-unknown-outcome' {Reject {Get-GateTestCounts (Write-Trx 'unknown-outcome' 'Completed' 1 1 0) 'trx'}}
+Check 'nunit-skips-not-executed' {
+    $path=Join-Path $ArtifactRoot 'skipped.xml'
+    "<test-run total='3' testcasecount='3' passed='1' failed='0' inconclusive='0' skipped='2' ignored='1'><test-case id='1' result='Passed'/><test-case id='2' result='Skipped' label='Ignored'/><test-case id='3' result='Skipped'/></test-run>"|Set-Content $path
+    $counts=Get-GateTestCounts $path 'nunit'
+    Require ($counts.executed -eq 1 -and $counts.skipped -eq 2 -and $counts.total -eq 3) 'Skipped tests counted as executed.'
+    Reject {Assert-GateTests $counts}
+}
+Check 'nunit-raw-skip-counter' {
+    $path=Join-Path $ArtifactRoot 'bad-skipped.xml'
+    "<test-run total='1' passed='0' failed='0' inconclusive='0' skipped='0'><test-case id='1' result='Skipped'/></test-run>"|Set-Content $path
+    Reject {Get-GateTestCounts $path 'nunit'}
+}
+Check 'audit-tests-na' {$v=Copy-Result $leaf;$v.tests=$null;Assert-GateResult $v $ArtifactRoot}
+Check 'build-missing-provenance' {$v=Copy-Result $leaf;$v.kind='dotnet-build';$v.tests=$null;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'focus-partial-aggregate4' {
+    $parent=New-GateResult $run 'gate' 'gate' $source ('c'*64) @('tests:fixture','tests:unselected')
+    $unselected=New-GateResult $run 'unselected' 'dotnet-test' $source ('c'*64) @('tests:unselected')
+    $parent.startedAt=$leaf.startedAt;$parent.endedAt=$leaf.endedAt
+    Merge-GateResults $parent @($leaf,$unselected)
+    Require ($parent.cliExitCode -eq 4 -and -not $parent.fullGateAccepted -and $parent.startedAt) 'Focus aggregate overstated coverage.'
+    Assert-GateResult $parent $ArtifactRoot
+}
+Check 'failure-precedence' {$v=Copy-Result $leaf;Set-GateTerminal $v 'Failed' 'business';$parent=New-GateResult $run 'parent' 'gate' $source ('c'*64) @('tests:fixture');Merge-GateResults $parent @($v);Require ($parent.cliExitCode -eq 1) 'Failure must dominate.'}
