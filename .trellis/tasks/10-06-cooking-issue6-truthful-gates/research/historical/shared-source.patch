+        $path=$queue.Dequeue();if($visited.ContainsKey($path)){continue};$visited[$path]=$true
+        $log=Join-Path $NodeRoot ('evaluate-'+$items.Count+'.json')
+        $query=Invoke-GateNative 'dotnet' (@('msbuild',$path,"-p:Configuration=$Configuration",'-getProperty:TargetPath,ProjectAssetsFile,TargetFramework','-getItem:ProjectReference','--nologo')+@($script:GateDotNetProperties | Where-Object { $_ })) $log
+        if($query.processExitCode -ne 0){throw 'Project closure evaluation failed.'}
+        $value=Get-Content -LiteralPath $log -Raw|ConvertFrom-Json
+        if(-not $value.Properties.TargetPath -or -not $value.Properties.ProjectAssetsFile){throw 'Project output/restore closure absent.'}
+        $items += [pscustomobject]@{project=$path;targetPath=$value.Properties.TargetPath;assetsPath=$value.Properties.ProjectAssetsFile;tfm=$value.Properties.TargetFramework}
+        foreach($reference in $value.Items.ProjectReference){
+            $next=[string]$reference.FullPath
+            if(-not $next){$next=Join-Path (Split-Path $path) $reference.Identity}
+            $queue.Enqueue([IO.Path]::GetFullPath($next))
+        }
+    }
+    return @($items)
+}
