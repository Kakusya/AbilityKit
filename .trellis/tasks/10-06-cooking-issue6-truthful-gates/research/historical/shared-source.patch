+function Assert-GateConsumerProvenance {
+    param($Result,[string]$RunRoot)
+    $p=$Result.provenance
+    if(-not $script:GateBuildValidation -or -not $script:GateBuildValidation.ContainsKey($Result.resultId)){throw 'No trusted invocation build-root context.'}
+    $context=$script:GateBuildValidation[$Result.resultId]
+    $path=Assert-GateBuildArtifact $p.manifest $context.buildRoot $p.manifest.producerRunId $p.manifest.producerResultId
+    $manifest=Get-Content -LiteralPath $path -Raw|ConvertFrom-Json
+    if($manifest.producerRunId -ne $p.manifest.producerRunId -or $manifest.producerResultId -ne $p.manifest.producerResultId){throw 'Manifest identity mismatch.'}
+    Assert-GateProvenance $manifest $context.buildRoot $context.repoRoot $context.source $Result.configSha256 $context.project $context.configuration $context.sdk $context.closure -AllowExample:$Result.example
