+# Validator expectations for the existing bodies; declarations live only in config.
+function Get-GateProducerContract {
+    param([string]$ScriptPath)
+    $contractRoot=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '..'))
+    $resolvedScript=[IO.Path]::GetFullPath($(if([IO.Path]::IsPathRooted($ScriptPath)){$ScriptPath}else{Join-Path $contractRoot $ScriptPath}))
+    if(-not $resolvedScript.StartsWith($contractRoot+[IO.Path]::DirectorySeparatorChar,[StringComparison]::OrdinalIgnoreCase)){return $null}
+    switch($resolvedScript.Substring($contractRoot.Length+1).Replace('\','/')){
+        {$_ -in @('tools/validate_moba_codegen_ownership.ps1','tools/audit_core_boundaries.ps1','tools/audit_unity_package_dependencies.ps1','tools/validate_moba_hero_acceptance_coverage.ps1','tools/moba_business_id.ps1')} {return @{evidenceType='audit';roles=@()}}
+        {$_ -in @('tools/moba_business_id.tests.ps1','tools/build_moba_content_report.tests.ps1')} {return @{evidenceType='assertions';roles=@()}}
+        'tools/check_sample_baseline.ps1' {return @{evidenceType='audit';roles=@();project='src/AbilityKit.Samples/AbilityKit.Samples.csproj'}}
+        'tools/run-unity-compile-check.ps1' {return @{evidenceType='build';roles=@();project='tools/unity-compile-check/UnityCompileCheck.csproj'}}
+        'tools/run_runtime_benchmarks.ps1' {return @{evidenceType='measurement';roles=@();project='src/AbilityKit.Runtime.Benchmarks/AbilityKit.Runtime.Benchmarks.csproj'}}
+        'tools/run_shooter_aoi_lod_gate.ps1' {return @{evidenceType='thresholds';roles=@();project='src/AbilityKit.Demo.Shooter.AoiLodBenchmarks/AbilityKit.Demo.Shooter.AoiLodBenchmarks.csproj'}}
+        'tools/build_moba_content_report.ps1' {return @{evidenceType='report';roles=@()}}
+        'tools/export_moba_content_ir.ps1' {return @{evidenceType='report';roles=@('content-report')}}
+        'tools/build_moba_content_graph.ps1' {return @{evidenceType='report';roles=@('content-ir','content-diagnostics')}}
+    }
+    return $null
+}
