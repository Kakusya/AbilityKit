+﻿# Shared result semantics. Dot-source; no work is launched while loading this file.
+function Get-GateHash {
+    param([string]$Path,[switch]$AllowEmptyImmutableInput)
+    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { throw "Missing artifact: $Path" }
+    if (-not $AllowEmptyImmutableInput -and (Get-Item -LiteralPath $Path).Length -eq 0) { throw "Empty artifact: $Path" }
+    return (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash.ToLowerInvariant()
+}
+
+function Get-GateFingerprint {
+    param([object[]]$Entries)
+    $text = (@($Entries | Sort-Object path | ForEach-Object { $_.path + [char]0 + $_.sha256 + "`n" }) -join '')
+    $algorithm = [System.Security.Cryptography.SHA256]::Create()
+    try { return ([BitConverter]::ToString($algorithm.ComputeHash([Text.Encoding]::UTF8.GetBytes($text)))).Replace('-', '').ToLowerInvariant() }
+    finally { $algorithm.Dispose() }
+}
+
+function Get-GateSource {
+    param([string]$RepoRoot)
+    $sha = (& git -C $RepoRoot rev-parse HEAD).Trim()
+    if ($LASTEXITCODE -ne 0) { throw 'Cannot capture source SHA.' }
+    $dirty = @(& git -C $RepoRoot status --porcelain).Count -gt 0
+    $paths = @(& git -C $RepoRoot ls-files -co --exclude-standard | Sort-Object -Unique)
+    $algorithm=[Security.Cryptography.SHA256]::Create()
+    $entries = @(try { foreach ($path in $paths) {
+        if ($path -match '\.(cs|csproj|props|targets|sln|json|ps1|py|config|lock|dll|asmdef|asmref|md|txt|meta|prefab|yml|yaml|rsp|ruleset)$' -and $path -notmatch '^\.(trellis|agents|codex)/|/(bin|obj|Library|Temp)/') {
+            $full = Join-Path $RepoRoot $path
+            if ([IO.File]::Exists($full)) {
+                # Empty source files are valid inputs, unlike result artifacts.
+                $stream=[IO.File]::OpenRead($full)
+                try{$hash=([BitConverter]::ToString($algorithm.ComputeHash($stream))).Replace('-','').ToLowerInvariant()}
+                finally{$stream.Dispose()}
+                [pscustomobject]@{ path=$path; sha256=$hash }
+            }
+        }
+    }}finally{$algorithm.Dispose()})
+    $fingerprint = Get-GateFingerprint (Get-GateLogicalInputs $entries)
+    return [pscustomobject]@{ sha=$sha; dirty=$dirty; inputManifestSha256=$fingerprint; inputManifestAfterSha256=$fingerprint; inputs=$entries }
+}
+
+function Assert-GateSource {
+    param($Before, $After)
+    if ($Before.sha -ne $After.sha -or $Before.dirty -ne $After.dirty -or $Before.inputManifestSha256 -ne $After.inputManifestSha256) { throw 'Source changed during invocation.' }
+}
+
