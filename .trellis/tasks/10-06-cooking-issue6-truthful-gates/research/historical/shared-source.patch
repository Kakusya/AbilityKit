+function Get-GateFileSet {
+    param([object[]]$Paths,[string]$RepoRoot,[switch]$AllowMissing)
+    $entries=@();$base=[IO.Path]::GetFullPath($RepoRoot).TrimEnd('\','/')+[IO.Path]::DirectorySeparatorChar
+    foreach($path in @($Paths|Sort-Object -Unique)){
+        $full=[IO.Path]::GetFullPath([string]$path)
+        if(-not $full.StartsWith($base,[StringComparison]::OrdinalIgnoreCase)){throw 'Evaluated output outside repository.'}
+        if(-not (Test-Path -LiteralPath $full -PathType Leaf)){if($AllowMissing){continue}else{throw "Required output missing: $full"}}
+        $entries += [pscustomobject]@{path=$full.Substring($base.Length).Replace('\','/');sha256=Get-GateHash $full}
+    }
+    return @($entries)
+}
+
+function Assert-GateFileSet {
+    param([object[]]$Entries,[string]$RepoRoot)
+    if(-not @($Entries).Count){throw 'Empty output manifest.'}
+    foreach($entry in $Entries){
+        $path=Resolve-GateArtifact $RepoRoot $entry.path
+        if((Get-GateHash $path) -ne $entry.sha256){throw "Stale/changed output: $($entry.path)"}
+    }
+}
+
+function Save-GateOutputSet {
+    param([object[]]$Entries,[string]$RepoRoot,[string]$NodeRoot,[string]$Prefix)
+    $saved=@();$index=0
+    foreach($entry in $Entries){
+        $name=$Prefix+'-'+$index+[IO.Path]::GetExtension($entry.path);$index++
+        $destination=Join-Path $NodeRoot $name
+        Copy-Item -LiteralPath (Resolve-GateArtifact $RepoRoot $entry.path) -Destination $destination
+        $saved += [pscustomobject]@{path=$entry.path;sha256=$entry.sha256;artifact=$name}
+    }
+    return @($saved)
+}
