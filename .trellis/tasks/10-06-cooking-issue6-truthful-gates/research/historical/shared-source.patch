+function Get-GateTestCounts {
+    param([string]$Path,[ValidateSet('trx','nunit')][string]$Format)
+    [xml]$xml=Get-Content -LiteralPath $Path -Raw
+    $counts=[ordered]@{declared=$true;total=0;resultEntries=0;executed=0;passed=0;failed=0;skipped=0;notExecuted=0}
+    $seen=@{}; $native=@{}
+    if($Format -eq 'trx') {
+        if($xml.DocumentElement.LocalName -ne 'TestRun'){throw 'TRX root missing.'}
+        $entries=@($xml.SelectNodes("/*[local-name()='TestRun']/*[local-name()='Results']/*[local-name()='UnitTestResult']"))
+        $counter=$xml.SelectSingleNode("/*[local-name()='TestRun']/*[local-name()='ResultSummary']/*[local-name()='Counters']")
+        if($null -eq $counter){throw 'TRX counters missing.'}
+        foreach($entry in $entries) {
+            $id=[string]$entry.executionId; $outcome=[string]$entry.outcome
+            if([string]::IsNullOrWhiteSpace($id) -or $seen.ContainsKey($id)){throw 'Duplicate or absent TRX execution ID.'}; $seen[$id]=$true
+            $key=$outcome.ToLowerInvariant(); if(-not $native.ContainsKey($key)){$native[$key]=0}; $native[$key]++
+            switch($outcome) {
+                'Passed' {$counts.passed++}
+                {$_ -in @('Failed','Error','Timeout','Aborted','Inconclusive','Warning')} {$counts.failed++}
+                {$_ -in @('NotExecuted','Pending','NotRunnable','Disconnected')} {$counts.notExecuted++}
+                default {throw "Unsupported TRX outcome $outcome"}
+            }
+        }
+        foreach($key in @('passed','failed','error','timeout','aborted','inconclusive','warning','notExecuted','pending','notRunnable','disconnected','completed','inProgress')) {
+            $actual=0; if($native.ContainsKey($key)){$actual=$native[$key]}
+            if($counter.HasAttribute($key)) { if([int]$counter.GetAttribute($key) -ne $actual){throw "TRX counter contradiction: $key"} }
+            elseif($actual -gt 0){throw "TRX counter absent: $key"}
+        }
+        $counts.executed=$counts.passed+$counts.failed
+        if(-not $counter.HasAttribute('executed') -or [int]$counter.executed -ne $counts.executed){throw 'TRX executed contradiction.'}
+        $counts.total=$entries.Count
+        if(-not $counter.HasAttribute('total') -or [int]$counter.total -ne $counts.total){throw 'TRX total contradiction.'}
+    } else {
+        $root=$xml.DocumentElement; if($root.LocalName -ne 'test-run'){throw 'NUnit root missing.'}
+        $entries=@($xml.SelectNodes('//test-case')); $rawFailed=0; $inconclusive=0; $ignored=0
+        foreach($entry in $entries) {
+            $id=[string]$entry.id
+            if([string]::IsNullOrWhiteSpace($id) -or $seen.ContainsKey($id)){throw 'Duplicate or absent NUnit case ID.'};$seen[$id]=$true
+            switch([string]$entry.result) {
+                'Passed' {$counts.passed++}
+                'Failed' {$counts.failed++;$rawFailed++}
+                'Inconclusive' {$counts.failed++;$inconclusive++}
+                {$_ -in @('Skipped','Ignored','Explicit')} {$counts.skipped++;if($_ -eq 'Ignored' -or [string]$entry.label -eq 'Ignored'){$ignored++}}
+                default {throw 'Unknown NUnit outcome.'}
+            }
+        }
+        $counts.total=$entries.Count;$counts.executed=$counts.passed+$counts.failed
+        foreach($pair in @(@('total',$counts.total),@('passed',$counts.passed),@('failed',$rawFailed),@('inconclusive',$inconclusive),@('skipped',$counts.skipped))) {
+            if(-not $root.HasAttribute($pair[0]) -or [int]$root.GetAttribute($pair[0]) -ne $pair[1]){throw "NUnit counter contradiction: $($pair[0])"}
+        }
+        if($root.HasAttribute('testcasecount') -and [int]$root.testcasecount -ne $counts.total){throw 'NUnit testcasecount contradiction.'}
+        if($root.HasAttribute('ignored') -and [int]$root.ignored -ne $ignored){throw 'NUnit ignored contradiction.'}
+        if($root.HasAttribute('executed') -and [int]$root.executed -ne $counts.executed){throw 'NUnit executed contradiction.'}
+    }
+    $counts.resultEntries=$counts.total
+    return [pscustomobject]$counts
+}
