+# Concrete declaration resolution is pure: uninvoked leaves do not probe a host.
+function Resolve-GateCoverage {
+    param($Step,[string]$Configuration)
+    $tokens=@($Step.coverage|ForEach-Object{([string]$_).Replace('{Configuration}',$Configuration)})
+    foreach($token in $tokens){if($token -match '\{|\}|project-tfm|listHash'){throw 'Unresolved coverage declaration.'}}
+    if($Step.PSObject.Properties['coverageDimensions']){
+        $dimensions=$Step.coverageDimensions
+        foreach($field in @('configuration','tfm','host','policy','scope')){if(-not $dimensions.$field){throw "Coverage dimension absent: $field"}}
+        $cfg=([string]$dimensions.configuration).Replace('{Configuration}',$Configuration)
+        $arguments=@();if($Step.PSObject.Properties['arguments']){$arguments=@($Step.arguments)}
+        # Paths express output routing, not successful coverage. Bind the exact configured
+        # argument vector (including placeholders) by a deterministic hash in the token.
+        $argumentHash=Get-GateFingerprint @(@{path='arguments';sha256=Get-GateStringHash (ConvertTo-Json -InputObject $arguments -Compress)})
+        $suffix='|configuration='+$cfg+'|tfm='+$dimensions.tfm+'|host='+$dimensions.host+'|policy='+$dimensions.policy+'|scope='+$dimensions.scope+'|arguments='+$argumentHash
+        $tokens=@($tokens|ForEach-Object{$_+$suffix})
+    }
+    return $tokens
+}
+function Get-GateStringHash {
+    param([string]$Value)
+    $hash=[Security.Cryptography.SHA256]::Create()
+    try{return ([BitConverter]::ToString($hash.ComputeHash([Text.Encoding]::UTF8.GetBytes($Value)))).Replace('-','').ToLowerInvariant()}
+    finally{$hash.Dispose()}
+}
+function Assert-GateCoverageProof {
+    param($Result,$Step,[string]$Configuration,[string]$NodeRoot)
+    if($Result.status -ne 'Passed' -or -not $Step.PSObject.Properties['coverageDimensions']){return}
+    $d=$Step.coverageDimensions;$cfg=([string]$d.configuration).Replace('{Configuration}',$Configuration)
+    if($Result.provenance){
+        if($Result.provenance.configuration -cne $cfg -or $Result.provenance.tfm -cne $d.tfm){throw 'Concrete configuration/TFM coverage mismatch.'}
+        if($d.host -cne 'dotnet'){throw 'Concrete evaluated .NET host mismatch.'}
+        $project=$(if($Step.kind -in @('dotnet-build','dotnet-test')){$Step.project}else{$Step.provenanceProject})
+        if([IO.Path]::GetFullPath($Result.provenance.project) -ine [IO.Path]::GetFullPath((Join-Path (Split-Path -Parent $PSScriptRoot) $project))){throw 'Concrete project coverage mismatch.'}
+    }elseif($d.tfm -cne 'N-A' -and $Result.kind -notlike 'unity-*'){throw 'Concrete TFM coverage lacks evaluated proof.'}
+    if($Result.kind -eq 'dotnet-test'){
+        $args=@($Result.command.arguments);$index=[Array]::IndexOf($args,'--filter')
+        $actual=$(if($index -ge 0){$args[$index+1]}else{'all'})
+        $expected=$(if($Step.filter){$Step.filter}else{'all'})
+        if($actual -cne $expected -or $d.scope -cne $expected){throw 'Concrete test filter coverage mismatch.'}
+    }
+    if($Result.kind -eq 'powershell-script'){
+        $contracts=@($Result.artifacts|Where-Object{$_.role -eq 'invocation-contract'})
+        if($contracts.Count -ne 1){throw 'Concrete script invocation contract missing.'}
+        $actual=Get-Content (Resolve-GateArtifact $NodeRoot $contracts[0].path) -Raw -Encoding UTF8|ConvertFrom-Json
+        if((ConvertTo-Json -InputObject @($actual.arguments) -Compress) -cne (ConvertTo-Json -InputObject @($Step.arguments) -Compress)){throw 'Concrete script argument coverage mismatch.'}
+        if($actual.actualParameters.PSObject.Properties['Configuration'] -and $actual.actualParameters.Configuration -cne $cfg){throw 'Concrete script configuration mismatch.'}
+    }
+    if($Result.kind -like 'unity-*'){
+        $proof=@($Result.artifacts|Where-Object{$_.role -eq 'unity-invocation-binding'})
+        if($proof.Count -ne 1){throw 'Concrete Unity binding missing.'}
+        $binding=Get-Content (Resolve-GateArtifact $NodeRoot $proof[0].path) -Raw -Encoding UTF8|ConvertFrom-Json
+        if($binding.host -cne $d.host -or $binding.scope -cne $d.scope -or $binding.policy -cne $d.policy){throw 'Concrete Unity host/filter/policy mismatch.'}
+    }
+}
+function Assert-GateObjectFields {
+    param($Value,[string[]]$Fields)
+    if($null -eq $Value -or (@($Value.PSObject.Properties.Name|Sort-Object) -join '|') -cne (@($Fields|Sort-Object) -join '|')){throw 'Source report schema fields mismatch.'}
+}
+function Assert-GateFinite {
+    param($Value,[switch]$Positive,[switch]$Integer)
+    if($null -eq $Value -or $Value -is [string] -or $Value -is [bool]){throw 'Report numeric field missing or wrong type.'}
+    $number=[double]$Value
+    if([double]::IsNaN($number) -or [double]::IsInfinity($number) -or $number -lt 0 -or ($Positive -and $number -le 0) -or ($Integer -and $number -ne [Math]::Floor($number))){throw 'Report numeric field invalid.'}
+}
+function Assert-GateNear {
+    param($Actual,$Expected)
+    Assert-GateFinite $Actual
+    if([Math]::Abs([double]$Actual-[double]$Expected) -gt (1e-8*[Math]::Max(1,[Math]::Abs([double]$Expected)))){throw 'Report summary/sample contradiction.'}
+}
+function Assert-GateRuntimeMeasurementReport {
+    param($Report,$Contract,[string]$Configuration)
+    Assert-GateObjectFields $Report @('schemaVersion','timestampUtc','profile','environment','options','metricDefinitions','results','notes')
+    if($Report.schemaVersion -cne 'abilitykit.runtime-benchmark.v1' -or $Report.profile -cne $Contract.profile){throw 'Runtime schema/profile mismatch.'}
+    Assert-GateObjectFields $Report.options @('warmupIterations','measurementIterations','invocationsPerIteration')
+    foreach($field in @('warmupIterations','measurementIterations','invocationsPerIteration')){
+        Assert-GateFinite $Report.options.$field -Integer -Positive:($field -ne 'warmupIterations')
+        if($Report.options.$field -ne $Contract.options.$field){throw 'Runtime configured sample options mismatch.'}
+    }
+    Assert-GateObjectFields $Report.environment @('machineName','osDescription','processArchitecture','frameworkDescription','processorCount','serverGc','buildConfiguration','commit')
+    if($Report.environment.buildConfiguration -cne $Configuration -or -not $Report.environment.commit){throw 'Runtime build configuration absent/mismatched.'}
+    Assert-GateFinite $Report.environment.processorCount -Integer -Positive
+    if(-not @($Report.results).Count -or @($Report.results).Count -ne @($Contract.cases).Count){throw 'Runtime expected nonzero case coverage missing.'}
+    $seen=@{}
+    foreach($case in $Report.results){
+        Assert-GateObjectFields $case @('descriptor','samples','summary','determinismDigest','result')
+        Assert-GateObjectFields $case.descriptor @('id','module','operationUnit','workload')
+        $id=$case.descriptor.id
+        if(-not $id -or $seen.ContainsKey($id)){throw 'Runtime duplicate/absent case ID.'};$seen[$id]=$true
+        $expected=@($Contract.cases|Where-Object{$_.id -ceq $id})
+        if($expected.Count -ne 1 -or $case.result -cne 'measurement' -or -not $case.determinismDigest){throw 'Runtime case/outcome/determinism contract failed.'}
+        if($case.descriptor.module -cne $expected[0].module -or $case.descriptor.operationUnit -cne $expected[0].operationUnit){throw 'Runtime descriptor module/unit mismatch.'}
+        Assert-GateObjectFields $case.descriptor.workload @($expected[0].workload.PSObject.Properties.Name)
+        foreach($field in $expected[0].workload.PSObject.Properties.Name){if($case.descriptor.workload.$field -cne $expected[0].workload.$field){throw 'Runtime workload dimensions mismatch.'}}
+        if(($Contract.module -ne 'all' -and $case.descriptor.module -cne $Contract.module) -or ($Contract.scope -ne 'all' -and $case.descriptor.workload.scope -cne $Contract.scope)){throw 'Runtime selected module/scope mismatch.'}
+        if(@($case.samples).Count -ne $Report.options.measurementIterations){throw 'Runtime samples missing.'}
+        $operations=0L;$allocated=0L;$weightedNs=0.0;$cpu=@();$index=0;$frequency=$null
+        foreach($sample in $case.samples){
+            Assert-GateObjectFields $sample @('index','operations','elapsedTimestampTicks','threadAllocatedBytes','nanosecondsPerOperation','allocatedBytesPerOperation')
+            foreach($field in @('index','operations','elapsedTimestampTicks','threadAllocatedBytes','nanosecondsPerOperation','allocatedBytesPerOperation')){Assert-GateFinite $sample.$field -Integer:($field -notmatch 'PerOperation') -Positive:($field -eq 'operations')}
+            if($sample.index -ne $index){throw 'Runtime sample index sequence mismatch.'};$index++
+            Assert-GateNear $sample.allocatedBytesPerOperation ($sample.threadAllocatedBytes/[double]$sample.operations)
+            if($sample.elapsedTimestampTicks -gt 0){
+                if($sample.nanosecondsPerOperation -le 0){throw 'Runtime timing contradiction.'}
+                $f=$sample.elapsedTimestampTicks*1e9/($sample.nanosecondsPerOperation*$sample.operations)
+                if($null -ne $frequency){Assert-GateNear $f $frequency}else{$frequency=$f}
+            }elseif($sample.nanosecondsPerOperation -ne 0){throw 'Runtime zero-tick contradiction.'}
+            $operations+=$sample.operations;$allocated+=$sample.threadAllocatedBytes;$weightedNs+=$sample.nanosecondsPerOperation*$sample.operations;$cpu+=,$sample.nanosecondsPerOperation
+        }
+        Assert-GateObjectFields $case.summary @('sampleCount','totalOperations','meanNanosecondsPerOperation','medianNanosecondsPerOperation','p95NanosecondsPerOperation','p99NanosecondsPerOperation','maxNanosecondsPerOperation','meanAllocatedBytesPerOperation','totalThreadAllocatedBytes','operationsPerSecond')
+        if($case.summary.sampleCount -ne $index -or $case.summary.totalOperations -ne $operations -or $case.summary.totalThreadAllocatedBytes -ne $allocated){throw 'Runtime summary counts mismatch.'}
+        $cpu=@($cpu|Sort-Object)
+        foreach($p in @(@('medianNanosecondsPerOperation',0.5),@('p95NanosecondsPerOperation',0.95),@('p99NanosecondsPerOperation',0.99))){Assert-GateNear $case.summary.($p[0]) $cpu[[Math]::Max(0,[Math]::Ceiling($index*$p[1])-1)]}
+        Assert-GateNear $case.summary.maxNanosecondsPerOperation $cpu[-1]
+        Assert-GateNear $case.summary.meanNanosecondsPerOperation ($weightedNs/$operations)
+        Assert-GateNear $case.summary.meanAllocatedBytesPerOperation ($allocated/[double]$operations)
+        Assert-GateNear $case.summary.operationsPerSecond $(if($weightedNs -gt 0){$operations*1e9/$weightedNs}else{0})
+    }
+    return $true
+}
+function Assert-GateShooterAoiReport {
+    param($Report,$Contract)
+    Assert-GateObjectFields $Report @('schemaVersion','timestampUtc','profile','environment','options','thresholds','metricDefinitions','results','passed')
+    if($Report.schemaVersion -cne 'abilitykit.shooter-aoi-lod-benchmark.v1' -or $Report.profile -cne $Contract.profile){throw 'AOI schema/profile mismatch.'}
+    foreach($part in @('options','thresholds')){
+        Assert-GateObjectFields $Report.$part @($Contract.$part.PSObject.Properties.Name)
+        foreach($field in $Contract.$part.PSObject.Properties.Name){if($Report.$part.$field -cne $Contract.$part.$field){throw 'AOI options/threshold policy mismatch.'}}
+    }
+    if(-not @($Report.results).Count -or @($Report.results).Count -ne @($Contract.cases).Count){throw 'AOI expected nonzero matrix coverage absent.'}
+    $seen=@{};$allPassed=$true
+    foreach($row in $Report.results){
+        Assert-GateObjectFields $row @('case','metrics','failures','passed')
+        Assert-GateObjectFields $row.case @('id','entities','observers','scenario')
+        $expected=@($Contract.cases|Where-Object{$_.id -ceq $row.case.id})
+        if($expected.Count -ne 1 -or $seen.ContainsKey($row.case.id)){throw 'AOI duplicate/wrong matrix case.'};$seen[$row.case.id]=$true
+        foreach($field in @('entities','observers','scenario')){if($row.case.$field -cne $expected[0].$field){throw 'AOI case dimensions mismatch.'}}
+        $metrics=@('meanTickMilliseconds','medianTickMilliseconds','normalizedNanosecondsPerEntityObserver','threadAllocatedBytesPerTick','allocatedBytesPerEntityObserver','exportMillisecondsPerTick','serializationMillisecondsPerTick','observationMillisecondsPerTick','exportAllocatedBytesPerTick','serializationAllocatedBytesPerTick','observationAllocatedBytesPerTick','payloadBytesPerTick','enterCount','leaveCount','changedCount','starvedEntitiesAtEnd','maxUnsentTicks','determinismDigest')
+        Assert-GateObjectFields $row.metrics $metrics
+        foreach($field in $metrics){Assert-GateFinite $row.metrics.$field}
+        if($row.metrics.changedCount -ne ($row.metrics.enterCount+$row.metrics.leaveCount)){throw 'AOI changed count contradiction.'}
+        $m=$row.metrics;$c=$row.case;$t=$Report.thresholds;$o=$Report.options
+        # Same comparisons as BenchmarkThresholdEvaluator, with no baseline configured
+        # by these wrappers. This verifies failures without changing native thresholds.
+        $values=@{
+            'cpu.normalizedNanoseconds'=@($m.normalizedNanosecondsPerEntityObserver,$t.maxNormalizedNanoseconds)
+            'allocation.bytesPerEntityObserver'=@($m.allocatedBytesPerEntityObserver,$t.maxAllocatedBytesPerEntityObserver)
+            'payload.bytesPerObserverTick'=@(($m.payloadBytesPerTick/[double]$c.observers),$t.maxPayloadBytesPerObserverTick)
+            'aoi.churnFractionPerTick'=@(($m.changedCount/[double]([Math]::Max(1,$c.entities*$c.observers*$o.measurementIterations*$o.ticksPerIteration))),$(if($c.scenario -ceq 'steady'){0}else{$t.maxChurnFractionPerTick}))
+            'starvation.entitiesPerObserver'=@(($m.starvedEntitiesAtEnd/[double]$c.observers),$(if($c.scenario -ceq 'steady'){0}else{$t.maxStarvedEntitiesPerObserver}))
+            'starvation.maxUnsentTicks'=@($m.maxUnsentTicks,$t.maxUnsentTicks)
+        }
+        $expectedFailures=@($values.Keys|Where-Object{$values[$_][0] -gt $values[$_][1]}|Sort-Object)
+        if((@($row.failures.metric|Sort-Object) -join '|') -cne ($expectedFailures -join '|')){throw 'AOI threshold failures contradict metrics.'}
+        foreach($failure in $row.failures){Assert-GateObjectFields $failure @('metric','actual','limit','message');Assert-GateNear $failure.actual $values[$failure.metric][0];Assert-GateNear $failure.limit $values[$failure.metric][1];if(-not $failure.message){throw 'AOI failure diagnostic absent.'}}
+        $passed=@($row.failures).Count -eq 0
+        if($row.passed -isnot [bool] -or $row.passed -ne $passed){throw 'AOI per-case Passed contradiction.'}
+        $allPassed=$allPassed -and $passed
+    }
+    if($Report.passed -isnot [bool] -or $Report.passed -ne $allPassed){throw 'AOI aggregate Passed contradiction.'}
+    return $allPassed
+}
+function Invoke-GateBenchmarkProducer {
+    param([string]$Project,[string]$Output,[string]$Profile,[string]$Module,[string]$Scope,[string]$Configuration,[switch]$NoRestore)
+    $p=$script:GateProducer;$context=$p.context
+    if($context.configuration -cne $Configuration){throw 'Benchmark configuration differs from caller.'}
+    if(-not $context.PSObject.Properties['reportContract']){throw 'Configured benchmark report contract absent.'}
+    $contract=$context.reportContract
+    if($Profile -cne $contract.profile -or $Module -cne $contract.module -or $Scope -cne $contract.scope){throw 'Benchmark requested scope differs from config.'}
+    $relative=$Output.Substring([IO.Path]::GetFullPath($context.nodeRoot).TrimEnd('\','/').Length+1).Replace('\','/')
+    if((Resolve-GateArtifact $context.nodeRoot $relative) -ine [IO.Path]::GetFullPath($Output)){throw 'Benchmark output outside invocation root.'}
+    if(Test-Path -LiteralPath $Output){throw 'Benchmark output already exists before native invocation.'}
+    $step=[pscustomobject]@{project=$context.provenanceProject;kind='dotnet-build'}
+    if($context.PSObject.Properties['coverageDimensions']){$step|Add-Member coverageDimensions $context.coverageDimensions}
+    $built=Invoke-GateDotNet $p.result $step $context.nodeRoot $context.runRoot $context.repoRoot $Configuration -PrepareOnly -NoRestore:$NoRestore -BuildManifestPath $context.buildManifestPath
+    $p.result=$built
+    if($built.status -in @('Blocked','Failed')){return (Complete-GateProducer $built.processExitCode $built.reason $built.status)}
+    $args=@('run','--project',$Project,'--configuration',$Configuration,'--no-build','--no-restore','--','--profile',$Profile,'--output',$Output)
+    if($context.evidenceType -eq 'measurement'){$args+=@('--module',$Module,'--scope',$Scope)}
+    $p.result.executionStartedAt=[DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')
+    Invoke-GateProducerCommand 'dotnet' $args|Out-Host
+    $native=$LASTEXITCODE
+    Assert-GateConsumerProvenance $p.result $context.runRoot
+    if(Test-Path -LiteralPath $Output -PathType Leaf){Add-GateProducerOutput $Output 'benchmark-report'}
+    $p.result.executionEndedAt=[DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')
+    $p.result.processExitCode=$native
+    if(Test-Path -LiteralPath $Output -PathType Leaf){
+        $bindingPath=Join-Path $context.nodeRoot 'benchmark-binding.json'
+        @{runId=$p.result.runId;resultId=$p.result.resultId;sourceSha=$p.result.source.sha;sourceFingerprint=$p.result.source.inputManifestSha256;profile=$Profile;module=$Module;scope=$Scope;configuration=$Configuration;reportSha256=Get-GateHash $Output;binaryManifestSha256=$p.result.provenance.manifest.sha256;nativeExit=$native}|ConvertTo-Json -Depth 10|Set-Content $bindingPath -Encoding UTF8
+        Add-GateProducerOutput $bindingPath 'benchmark-binding'
+    }
+    $accepted=Assert-GateBenchmarkEvidence $p.result $context -ReturnOutcome
+    if($context.evidenceType -eq 'thresholds'){
+        if(($accepted -and $native -ne 0) -or (-not $accepted -and $native -ne 2)){throw 'AOI native exit/report outcome contradiction.'}
+    }elseif($native -ne 0){throw 'Runtime measurement native failure.'}
+    return (Complete-GateProducer $native $(if($accepted){$null}else{'AoiThresholdRejected'}) $(if($accepted){'Passed'}else{'Failed'}))
+}
+function Assert-GateBenchmarkEvidence {
+    param($Result,$Context,[switch]$ReturnOutcome)
+    $raw=@($Result.artifacts|Where-Object{$_.role -eq 'benchmark-report'})
+    if($raw.Count -ne 1){throw 'Current benchmark report absent.'}
+    $path=Resolve-GateArtifact $Context.nodeRoot $raw[0].path
+    if((Get-GateHash $path) -ne $raw[0].sha256){throw 'Benchmark report changed.'}
+    $report=Get-Content $path -Raw -Encoding UTF8|ConvertFrom-Json
+    $bindings=@($Result.artifacts|Where-Object{$_.role -eq 'benchmark-binding'})
+    if($bindings.Count -ne 1){throw 'Benchmark current invocation binding absent.'}
+    $binding=Get-Content (Resolve-GateArtifact $Context.nodeRoot $bindings[0].path) -Raw -Encoding UTF8|ConvertFrom-Json
+    if($binding.runId -cne $Result.runId -or $binding.resultId -cne $Result.resultId -or $binding.sourceSha -cne $Result.source.sha -or $binding.sourceFingerprint -cne $Result.source.inputManifestSha256 -or $binding.reportSha256 -cne $raw[0].sha256 -or $binding.binaryManifestSha256 -cne $Result.provenance.manifest.sha256 -or $binding.nativeExit -ne $Result.processExitCode -or $binding.profile -cne $Context.reportContract.profile -or $binding.module -cne $Context.reportContract.module -or $binding.scope -cne $Context.reportContract.scope -or $binding.configuration -cne $Context.configuration){throw 'Benchmark invocation/report binding mismatch.'}
+    $timestamp=[DateTimeOffset]$report.timestampUtc
+    if($timestamp -lt [DateTimeOffset]$Result.executionStartedAt -or $timestamp -gt ([DateTimeOffset]$Result.executionEndedAt).AddSeconds(1)){throw 'Old/out-of-invocation benchmark report.'}
+    $outcome=$(if($Context.evidenceType -eq 'measurement'){Assert-GateRuntimeMeasurementReport $report $Context.reportContract $Context.configuration}else{Assert-GateShooterAoiReport $report $Context.reportContract})
+    if(-not $Result.provenance){throw 'Benchmark source/binary provenance absent.'}
+    Assert-GateConsumerProvenance $Result $Context.runRoot
+    if($ReturnOutcome){return $outcome}
+    if(-not $outcome){throw 'Benchmark report did not complete accepted coverage.'}
+}
+function Get-GateBindingIds {
+    param($Bindings,[string]$Token)
+    if($Bindings -is [System.Collections.IDictionary]){return @($Bindings[$Token])}
+    if($Bindings.PSObject.Properties[$Token]){return @($Bindings.PSObject.Properties[$Token].Value)}
+    return @()
+}
+function ConvertTo-GateProcessArgument {
+    param([string]$Value)
+    # Windows CommandLineToArgvW-compatible quoting, including trailing slashes.
+    if($Value -notmatch '[\s"]' -and $Value.Length){return $Value}
+    $escaped=[regex]::Replace($Value,'(\\*)"','$1$1\"')
+    $escaped=[regex]::Replace($escaped,'(\\+)$','$1$1')
+    return '"'+$escaped+'"'
+}
