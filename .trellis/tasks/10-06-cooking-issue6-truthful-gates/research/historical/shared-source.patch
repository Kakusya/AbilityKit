+function New-GateResult {
+    param([string]$RunId, [string]$Name, [string]$Kind, $Source, [string]$ConfigHash, [string[]]$Tokens, [bool]$Required=$true, [string]$ResultId=([guid]::NewGuid().ToString()))
+    $requiredTokens = @(); $optionalTokens = @()
+    if ($Required) { $requiredTokens=@($Tokens) } else { $optionalTokens=@($Tokens) }
+    return [pscustomobject][ordered]@{
+        schemaVersion=1; example=$false; resultType=$(if($Kind -eq 'gate'){'gate'}else{'step'}); runId=$RunId; resultId=$ResultId
+        name=$Name; kind=$Kind; status='NotRun'; cliExitCode=4; processExitCode=$null; reason='Unselected or not reached'; required=$Required
+        source=[pscustomobject]@{sha=$Source.sha;dirty=$Source.dirty;inputManifestSha256=$Source.inputManifestSha256;inputManifestAfterSha256=$Source.inputManifestSha256}
+        configSha256=$ConfigHash; startedAt=$null; endedAt=$null; executionStartedAt=$null; executionEndedAt=$null; command=$null; tools=@()
+        coverage=[pscustomobject]@{required=$requiredTokens;optional=$optionalTokens;completed=@();missingRequired=$requiredTokens;missingOptional=$optionalTokens;bindings=@{}}
+        tests=$null; artifacts=@(); fullGateAccepted=$false; steps=@(); originalResult=$null; provenance=$null
+    }
+}
+
+function Set-GateTerminal {
+    param($Result, [ValidateSet('Passed','Failed','Blocked','Skipped','NotRun')][string]$Status, [string]$Reason)
+    $Result.status=$Status; $Result.cliExitCode=@{Passed=0;Failed=1;Blocked=2;Skipped=3;NotRun=4}[$Status]
+    $Result.reason=$(if($Status -eq 'Passed'){$null}elseif([string]::IsNullOrWhiteSpace($Reason)){$Status}else{$Reason})
+    if ($Status -eq 'Passed') {
+        $Result.coverage.bindings=@{}
+        $Result.coverage.completed=@($Result.coverage.required + $Result.coverage.optional)
+        $Result.coverage.missingRequired=@(); $Result.coverage.missingOptional=@()
+        foreach($token in $Result.coverage.completed) { $Result.coverage.bindings[$token]=@($Result.resultId) }
+    } else {
+        $Result.coverage.completed=@(); $Result.coverage.bindings=@{}
+        $Result.coverage.missingRequired=@($Result.coverage.required); $Result.coverage.missingOptional=@($Result.coverage.optional)
+    }
+}
