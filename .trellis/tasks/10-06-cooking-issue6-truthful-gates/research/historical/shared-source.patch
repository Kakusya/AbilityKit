+# A child may describe its provenance, but only the parent chooses validation roots,
+# project/configuration, tool identity and evaluated closure.
+function Register-GateChildProvenance {
+    param($Result,$Context,[string]$Project,[string[]]$Properties=@(),[string]$PriorManifestPath)
+    if(-not $Result.provenance){return}
+    if(-not $Project){throw 'Child provenance has no parent-owned project contract.'}
+    $root=$Context.nodeRoot
+    if($Result.provenance.noBuild){
+        if(-not $PriorManifestPath){throw 'Child requested unapproved prior build root.'}
+        $root=Split-Path -Parent ([IO.Path]::GetFullPath($PriorManifestPath))
+    }
+    $projectPath=[IO.Path]::GetFullPath((Join-Path $Context.repoRoot $Project))
+    $sdk=(& dotnet --version).Trim();if($LASTEXITCODE -ne 0){throw 'Cannot bind child SDK.'}
+    $versions=@($Result.tools|Where-Object{$_.name -eq 'dotnet'})
+    if($versions.Count -ne 1 -or $versions[0].version -cne $sdk){throw 'Child tool version differs from parent probe.'}
+    $validationRoot=Join-Path $Context.nodeRoot 'parent-validation';$null=New-Item -ItemType Directory $validationRoot -Force
+    $old=$script:GateDotNetProperties
+    try{$script:GateDotNetProperties=$Properties;$closure=Get-GateProjectClosure $projectPath $Context.configuration $validationRoot}
+    finally{$script:GateDotNetProperties=$old}
+    if(-not $script:GateBuildValidation){$script:GateBuildValidation=@{}}
+    $script:GateBuildValidation[$Result.resultId]=@{buildRoot=$root;repoRoot=$Context.repoRoot;source=$Context.source;project=$projectPath;configuration=$Context.configuration;sdk=$sdk;closure=$closure}
+    Assert-GateConsumerProvenance $Result $Context.runRoot
+}
+
+function New-GateBuildArtifact {
+    param([string]$BuildRoot,[string]$Path,[string]$Role,[string]$RunId,[string]$ResultId)
+    $relative=[IO.Path]::GetFullPath($Path).Substring([IO.Path]::GetFullPath($BuildRoot).TrimEnd('\','/').Length+1).Replace('\','/')
+    $resolved=Resolve-GateArtifact $BuildRoot $relative
+    return [pscustomobject]@{root='build';role=$Role;path=$relative;bytes=(Get-Item -LiteralPath $resolved).Length;sha256=Get-GateHash $resolved -AllowEmptyImmutableInput:($Role -eq 'immutable-input');producerRunId=$RunId;producerResultId=$ResultId}
+}
+
+function Assert-GateBuildArtifact {
+    param($Artifact,[string]$BuildRoot,[string]$RunId,[string]$ResultId,[switch]$AllowBoundImmutableInput)
+    if($Artifact.root -ne 'build' -or $Artifact.producerRunId -ne $RunId -or $Artifact.producerResultId -ne $ResultId){throw 'Build artifact producer mismatch.'}
+    $path=Resolve-GateArtifact $BuildRoot $Artifact.path
+    if($AllowBoundImmutableInput -and $Artifact.role -ne 'immutable-input'){throw 'Invalid immutable input role.'}
+    if((Get-Item -LiteralPath $path).Length -ne $Artifact.bytes -or (Get-GateHash $path -AllowEmptyImmutableInput:$AllowBoundImmutableInput) -ne $Artifact.sha256){throw 'Build artifact size/hash mismatch.'}
+    return $path
+}
+
+function Save-GateBoundInputs {
+    param([object[]]$Entries,[string]$RepoRoot,[string]$BuildRoot,[string]$RunId,[string]$ResultId,[string]$Prefix)
+    $directory=Join-Path $BuildRoot 'source';$null=New-Item -ItemType Directory -Path $directory -Force
+    $index=0;$saved=@()
+    foreach($entry in $Entries){
+        $destination=Join-Path $directory ($Prefix+'-'+$index+'.input');$index++
+        $sourcePath=Join-Path $RepoRoot $entry.path
+        Copy-Item -LiteralPath $sourcePath -Destination $destination
+        # Input logical paths use generated IDs, private mapping retains source filenames.
+        $logical=(Get-GateLogicalInputs @($entry))[0].path
+        $artifact=New-GateBuildArtifact $BuildRoot $destination 'immutable-input' $RunId $ResultId
+        if($artifact.sha256 -ne $entry.sha256){throw 'Input changed while archiving.'}
+        $saved += [pscustomobject]@{path=$logical;sha256=$entry.sha256;artifact=$artifact}
+    }
+    return @($saved)
+}
+
+function Get-GateLogicalInputs {
+    param([object[]]$Entries)
+    return @(foreach($entry in $Entries){
+        $algorithm=[Security.Cryptography.SHA256]::Create()
+        try{$logical='input-'+([BitConverter]::ToString($algorithm.ComputeHash([Text.Encoding]::UTF8.GetBytes($entry.path)))).Replace('-','').ToLowerInvariant()}
+        finally{$algorithm.Dispose()}
+        [pscustomobject]@{path=$logical;sha256=$entry.sha256}
+    })
+}
+
+function Get-GateRestoreBundle {
+    param($Manifest,[string]$BuildRoot,[string]$RepoRoot,[object[]]$ExpectedClosure,[switch]$AllowExample)
+    $path=Assert-GateBuildArtifact $Manifest.restore.assetsAfter $BuildRoot $Manifest.restore.producerRunId $Manifest.restore.producerResultId
+    $bundle=Get-Content -LiteralPath $path -Raw|ConvertFrom-Json
+    if(($bundle.example -and -not $AllowExample) -or -not @($bundle.assets).Count){throw 'Synthetic or empty assets bundle.'}
+    $seen=@{};$expected=@{}
+    foreach($project in $ExpectedClosure){$key=([IO.Path]::GetFullPath($project.project)+'|'+$project.tfm);$expected[$key]=[IO.Path]::GetFullPath($project.assetsPath)}
+    foreach($entry in $bundle.assets){
+        if($seen.ContainsKey($entry.projectKey)){throw 'Duplicate restore project/TFM key.'};$seen[$entry.projectKey]=$true
+        if(-not $expected.ContainsKey($entry.projectKey) -or [IO.Path]::GetFullPath((Join-Path $RepoRoot $entry.path)) -ne $expected[$entry.projectKey]){throw 'Extra or mismatched restore closure entry.'}
+        $null=Assert-GateBuildArtifact $entry.artifact $BuildRoot $Manifest.restore.producerRunId $Manifest.restore.producerResultId
+        if($entry.sha256 -ne $entry.artifact.sha256){throw 'Restore output binding mismatch.'}
+    }
+    if($seen.Count -ne $expected.Count){throw 'Missing referenced project assets.'}
+    Assert-GateFileSet $bundle.assets $RepoRoot
+    return $bundle
+}
+
+function Assert-GateProvenance {
+    param($Manifest,[string]$BuildRoot,[string]$RepoRoot,$Source,[string]$ConfigHash,[string]$Project,[string]$Configuration,[string]$Sdk,[object[]]$ExpectedClosure,[switch]$RestoreOnly,[switch]$AllowExample)
+    $fields=@('example','producerRunId','producerResultId','source','configSha256','project','configuration','tfm','sdk','immutableInputs','lockFile','restore','build','binaries')
+    foreach($field in $fields){if(-not $Manifest.PSObject.Properties[$field]){throw "Missing manifest field $field"}}
+    foreach($field in $Manifest.PSObject.Properties.Name){if($field -notin $fields){throw "Unknown manifest field $field"}}
+    if($Manifest.example -and -not $AllowExample){throw 'Synthetic production build manifest.'}
+    if($Manifest.source.sha -ne $Source.sha -or $Manifest.source.dirty -ne $Source.dirty -or $Manifest.source.inputManifestSha256 -ne $Source.inputManifestSha256 -or $Manifest.source.inputManifestAfterSha256 -ne $Source.inputManifestSha256 -or $Manifest.configSha256 -ne $ConfigHash -or $Manifest.project -ne $Project -or $Manifest.configuration -ne $Configuration -or $Manifest.sdk -ne $Sdk){throw 'Build source/configuration/SDK mismatch.'}
+    if(-not @($ExpectedClosure).Count -or [string]::IsNullOrWhiteSpace($Manifest.tfm) -or $Manifest.tfm -cne $ExpectedClosure[0].tfm){throw 'Evaluated target framework mismatch.'}
+    if($Manifest.restore.processExitCode -ne 0 -or $Manifest.build.processExitCode -ne 0){throw 'Prior restore/build not valid.'}
+    $restoreArguments=@($Manifest.restore.command.arguments);$buildArguments=@($Manifest.build.command.arguments)
+    if($Manifest.restore.command.executable -cne 'dotnet' -or $Manifest.build.command.executable -cne 'dotnet' -or $restoreArguments.Count -lt 2 -or $restoreArguments[0] -cne 'restore' -or $restoreArguments[1] -cne $Project -or $buildArguments.Count -lt 4 -or $buildArguments[0] -cne 'build' -or $buildArguments[1] -cne $Project -or '-c' -notin $buildArguments -or $buildArguments[[Array]::IndexOf($buildArguments,'-c')+1] -cne $Configuration -or '--no-restore' -notin $buildArguments){throw 'Stage command project/configuration contract mismatch.'}
+    $boundImmutable=@{}
+    foreach($input in $Manifest.immutableInputs){
+        $null=Assert-GateBuildArtifact $input.artifact $BuildRoot $Manifest.producerRunId $Manifest.producerResultId -AllowBoundImmutableInput
+        if($boundImmutable.ContainsKey($input.path)){throw 'Duplicate immutable input binding.'}
+        $boundImmutable[$input.path]=$input
+        if($input.sha256 -ne $input.artifact.sha256){throw 'Immutable input artifact contradiction.'}
+    }
+    if((Get-GateFingerprint $Manifest.immutableInputs) -ne $Source.inputManifestSha256){throw 'Immutable input fingerprint contradiction.'}
+    foreach($stage in @($Manifest.restore,$Manifest.build)){
+        if($stage.inputBeforeSha256 -ne $stage.inputAfterSha256 -or (Get-GateFingerprint $stage.inputs) -ne $stage.inputBeforeSha256){throw 'Stage input contradiction.'}
+        foreach($input in $stage.inputs){
+            $owner=$input.artifact.producerResultId
