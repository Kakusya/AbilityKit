+﻿param([string]$ArtifactRoot,[switch]$SkipRunnerIntegration,[string]$ControlFilter)
+$ErrorActionPreference='Stop'
+$repoRoot=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+. (Join-Path $repoRoot 'tools/test-gate-result-contract.ps1')
+$actualSourceReader=(Get-Command Get-GateSource).ScriptBlock
+$sourceBefore=& $actualSourceReader $repoRoot
+$testInputsBefore=@(Get-ChildItem -LiteralPath $PSScriptRoot -Recurse -File|Where-Object{$_.Extension -in @('.ps1','.py','.json')}|Sort-Object FullName|ForEach-Object{@{path=$_.FullName.Substring($repoRoot.Length+1).Replace('\','/');sha256=Get-GateHash $_.FullName}})
+$invocationArguments=@('-NoProfile','-ExecutionPolicy','Bypass','-File','tools/tests/test-gate-result-contract.tests.ps1')
+if($PSBoundParameters.ContainsKey('ArtifactRoot')){$invocationArguments+=@('-ArtifactRoot',$ArtifactRoot)}
+if($SkipRunnerIntegration){$invocationArguments+='-SkipRunnerIntegration'}
+if($ControlFilter){$invocationArguments+=@('-ControlFilter',$ControlFilter)}
+$pythonVersion=(& python --version 2>&1|Out-String).Trim()
+if(-not $ArtifactRoot){$ArtifactRoot=Join-Path $repoRoot ('local/Artifacts/i6-'+[guid]::NewGuid().ToString())}
+$ArtifactRoot=[IO.Path]::GetFullPath($ArtifactRoot)
+$null=New-Item -ItemType Directory -Path $ArtifactRoot -Force
+$cases=New-Object 'System.Collections.Generic.List[object]'
+function Check([string]$Name,[scriptblock]$Body){
+    if($ControlFilter -and $Name -notlike $ControlFilter){$cases.Add(@{name=$Name;status='NotRun';reason='Focused control filter'});return}
+    try{& $Body;$cases.Add(@{name=$Name;status='Passed'})}
+    catch{$cases.Add(@{name=$Name;status='Failed';reason=$_.Exception.Message});Write-Host "FAIL $Name : $_"}
+}
+function Require($Condition,[string]$Message){if(-not $Condition){throw $Message}}
+function Reject([scriptblock]$Body){$rejected=$false;try{& $Body}catch{$rejected=$true};Require $rejected 'Expected rejection did not occur.'}
+function Copy-Result($Value){return $Value|ConvertTo-Json -Depth 80|ConvertFrom-Json}
+$source=@{sha=('a'*40);dirty=$false;inputManifestSha256=('b'*64)}
+$run=[guid]::NewGuid().ToString()
+$leaf=New-GateResult $run 'fixture assertion producer' 'powershell-script' $source ('c'*64) @('tests:fixture')
+$leaf.startedAt='2026-10-04T00:00:00Z';$leaf.endedAt='2026-10-04T00:00:05Z';$leaf.executionStartedAt='2026-10-04T00:00:01Z';$leaf.executionEndedAt='2026-10-04T00:00:04Z'
+$leaf.command=@{executable='fixture';arguments=@('test')};$leaf.processExitCode=0
+$leaf.tests=@{declared=$true;total=1;resultEntries=1;executed=1;passed=1;failed=0;skipped=0;notExecuted=0}
+$node=Join-Path $ArtifactRoot $leaf.resultId;$null=New-Item -ItemType Directory $node
+Set-Content (Join-Path $node 'report.txt') 'owned evidence' -Encoding UTF8
+Add-GateArtifact $leaf $ArtifactRoot (Join-Path $node 'report.txt') 'report'
+Require ((Get-Item (Join-Path $node 'report.txt')).Length -gt 0) 'Owned fixture evidence must exist.'
+ConvertTo-Json -InputObject @(@{id='fixture-assertion-1';outcome='Passed';name='owned fixture artifact exists'})|Set-Content (Join-Path $node 'assertions.json') -Encoding UTF8
+Add-GateArtifact $leaf $ArtifactRoot (Join-Path $node 'assertions.json') 'assertions'
+Set-GateTerminal $leaf 'Passed' $null
+Check 'valid-semantic-leaf' {Assert-GateResult $leaf $ArtifactRoot}
+foreach($field in @('runId','resultId','coverage','source','status','command','tests','artifacts')){
+    Check "missing-$field" {$v=Copy-Result $leaf;$v.PSObject.Properties.Remove($field);Reject {Assert-GateResult $v $ArtifactRoot}}
+}
+Check 'unknown-field' {$v=Copy-Result $leaf;$v|Add-Member invented 1;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'production-example' {$v=Copy-Result $leaf;$v.example=$true;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'canonical-exit' {$v=Copy-Result $leaf;$v.cliExitCode=2;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'native-failure-zero-cli' {$v=Copy-Result $leaf;$v.processExitCode=2;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'source-mutated' {$v=Copy-Result $leaf;$v.source.inputManifestAfterSha256='d'*64;Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'process-time-outside-invocation' {$v=Copy-Result $leaf;$v.executionEndedAt='2026-10-04T00:00:06Z';Reject {Assert-GateResult $v $ArtifactRoot}}
+Check 'negative-duration' {$v=Copy-Result $leaf;$v.endedAt='2026-10-03T00:00:00Z';Reject {Assert-GateResult $v $ArtifactRoot}}
+foreach($counter in @('total','executed','resultEntries','passed','failed','skipped','notExecuted')){
