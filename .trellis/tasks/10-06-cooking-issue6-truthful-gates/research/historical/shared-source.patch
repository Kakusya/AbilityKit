+function Assert-GateUnityBuildProof {
+    param([string]$ProofPath,$Result,[string]$UnityVersion,[string]$EditorPath,[string[]]$AssemblyPaths,[string]$ProjectPath)
+    if(-not $ProjectPath){$ProjectPath=Join-Path (Split-Path -Parent $PSScriptRoot) 'Unity'}
+    if(-not $ProofPath -or -not (Test-Path -LiteralPath $ProofPath -PathType Leaf)){return $null}
+    $root=Split-Path -Parent ([IO.Path]::GetFullPath($ProofPath))
+    $proof=Get-Content $ProofPath -Raw -Encoding UTF8|ConvertFrom-Json
+    Assert-GateObjectFields $proof @('schemaVersion','example','producerRunId','producerResultId','configSha256','source','unityVersion','editor','assemblies','command','processExitCode','status','startedAt','endedAt','buildLog')
+    if($proof.schemaVersion -cne 'abilitykit.unity-build-proof.v1' -or $proof.example -isnot [bool] -or ($proof.example -and -not $Result.example) -or $proof.producerRunId -cne $Result.runId -or -not [guid]::TryParse($proof.producerResultId,[ref]([guid]::Empty)) -or $proof.configSha256 -cne $Result.configSha256 -or $proof.unityVersion -cne $UnityVersion -or $proof.status -cne 'Passed' -or $proof.processExitCode -ne 0){throw 'Unity current build proof identity/status mismatch.'}
+    Assert-GateSource $proof.source $Result.source
+    if($proof.source.inputManifestAfterSha256 -cne $proof.source.inputManifestSha256){throw 'Unity build source changed.'}
+    if(-not $proof.startedAt -or -not $proof.endedAt -or [DateTimeOffset]$proof.endedAt -lt [DateTimeOffset]$proof.startedAt -or [DateTimeOffset]$proof.endedAt -gt [DateTimeOffset]::UtcNow.AddSeconds(1)){throw 'Unity build times invalid.'}
+    if([IO.Path]::GetFullPath($proof.command.executable) -ine [IO.Path]::GetFullPath($EditorPath) -or '-batchmode' -notin @($proof.command.arguments) -or '-projectPath' -notin @($proof.command.arguments)){throw 'Unity build command not bound to editor/project.'}
+    $projectIndex=[Array]::IndexOf(@($proof.command.arguments),'-projectPath')
+    if([IO.Path]::GetFullPath($proof.command.arguments[$projectIndex+1]) -ine [IO.Path]::GetFullPath($ProjectPath)){throw 'Unity build project mismatch.'}
+    $entries=@($proof.editor)+@($proof.assemblies)
+    $expected=@([IO.Path]::GetFullPath($EditorPath))+@($AssemblyPaths|ForEach-Object{[IO.Path]::GetFullPath($_)})
+    if(@($entries).Count -ne @($expected).Count -or ((@($entries|ForEach-Object{[IO.Path]::GetFullPath($_.originalPath)}|Sort-Object) -join '|') -ine (@($expected|Sort-Object) -join '|'))){throw 'Unity expected binary closure mismatch.'}
+    foreach($entry in $entries){
+        Assert-GateObjectFields $entry @('originalPath','beforeSha256','afterSha256','artifact')
+        $archived=Assert-GateBuildArtifact $entry.artifact $root $proof.producerRunId $proof.producerResultId
+        if($entry.beforeSha256 -cne $entry.afterSha256 -or $entry.artifact.sha256 -cne $entry.afterSha256 -or (Get-GateHash $entry.originalPath) -cne $entry.afterSha256){throw 'Unity historical/current binary identity mismatch.'}
+    }
+    $null=Assert-GateBuildArtifact $proof.buildLog $root $proof.producerRunId $proof.producerResultId
+    return [pscustomobject]@{path=[IO.Path]::GetFullPath($ProofPath);root=$root;value=$proof;sha256=Get-GateHash $ProofPath;expectedPaths=$AssemblyPaths;editorPath=$EditorPath;version=$UnityVersion;projectPath=$ProjectPath}
+}
+function Save-GateUnityBuildProof {
+    param($Result,$Proof,[string]$RunRoot,[string]$NodeRoot)
+    if(-not $Proof){throw 'Unity prerequisite proof absent.'}
+    $directory=Join-Path $NodeRoot 'unity-proof';$null=New-Item -ItemType Directory $directory -Force
+    $copy=$Proof.value|ConvertTo-Json -Depth 25|ConvertFrom-Json
+    $index=0
+    foreach($entry in @($copy.editor)+@($copy.assemblies)){
+        $from=Resolve-GateArtifact $Proof.root $entry.artifact.path
+        $to=Join-Path $directory ('binary-'+$index+'.bin');$index++;Copy-Item -LiteralPath $from -Destination $to
+        $entry.artifact=New-GateBuildArtifact $NodeRoot $to 'unity-build-binary' $copy.producerRunId $copy.producerResultId
+        Add-GateArtifact $Result $RunRoot $to 'unity-build-binary'
+    }
+    $to=Join-Path $directory 'build.log';Copy-Item -LiteralPath (Resolve-GateArtifact $Proof.root $copy.buildLog.path) -Destination $to
+    $copy.buildLog=New-GateBuildArtifact $NodeRoot $to 'unity-build-log' $copy.producerRunId $copy.producerResultId
+    Add-GateArtifact $Result $RunRoot $to 'unity-build-log'
+    $path=Join-Path $NodeRoot 'unity-build-proof.json';$copy|ConvertTo-Json -Depth 25|Set-Content $path -Encoding UTF8
+    Add-GateArtifact $Result $RunRoot $path 'unity-build-proof'
+    if(-not $script:GateUnityValidation){$script:GateUnityValidation=@{}}
+    $script:GateUnityValidation[$Result.resultId]=@{version=$Proof.version;editorPath=$Proof.editorPath;assemblyPaths=$Proof.expectedPaths;proofPath=$path;projectPath=$Proof.projectPath}
+}
+function Assert-GateUnityEvidence {
+    param($Result,[string]$RunRoot)
+    if(-not $script:GateUnityValidation -or -not $script:GateUnityValidation.ContainsKey($Result.resultId)){throw 'Unity trusted host/binary context absent.'}
+    $trusted=$script:GateUnityValidation[$Result.resultId]
+    $null=Assert-GateUnityBuildProof $trusted.proofPath $Result $trusted.version $trusted.editorPath $trusted.assemblyPaths $trusted.projectPath
+    if($Result.kind -notlike 'unity-*'){return}
+    $node=Join-Path $RunRoot $Result.resultId
+    $bindings=@($Result.artifacts|Where-Object{$_.role -eq 'unity-invocation-binding'})
+    if($bindings.Count -ne 1){throw 'Unity invocation binding absent.'}
+    $binding=Get-Content (Resolve-GateArtifact $node $bindings[0].path) -Raw -Encoding UTF8|ConvertFrom-Json
+    if($binding.runId -cne $Result.runId -or $binding.resultId -cne $Result.resultId -or $binding.source.inputManifestSha256 -cne $Result.source.inputManifestSha256 -or $binding.source.sha -cne $Result.source.sha -or $binding.kind -cne $Result.kind -or $binding.editorSha256 -cne (Get-GateHash $trusted.editorPath)){throw 'Unity invocation identity changed.'}
+    $reports=@($Result.artifacts|Where-Object{$_.role -eq $(if($Result.kind -eq 'unity-execute-method'){'report'}else{'nunit'})})
+    if($reports.Count -ne 1 -or $binding.reportSha256 -cne $reports[0].sha256){throw 'Unity raw report binding mismatch.'}
+    if($Result.kind -eq 'unity-execute-method'){
+        $raw=Get-Content (Resolve-GateArtifact $node $reports[0].path) -Raw -Encoding UTF8|ConvertFrom-Json
+        Assert-GateObjectFields $raw @('schemaVersion','runId','resultId','sourceSha','sourceFingerprint','executeMethod','status','completed','startedAt','endedAt')
+        if($raw.schemaVersion -cne 'abilitykit.unity-execute-method.v1' -or $raw.runId -cne $Result.runId -or $raw.resultId -cne $Result.resultId -or $raw.sourceSha -cne $Result.source.sha -or $raw.sourceFingerprint -cne $Result.source.inputManifestSha256 -or $raw.executeMethod -cne $binding.scope -or $raw.status -cne 'Passed' -or $raw.completed -isnot [bool] -or -not $raw.completed -or [DateTimeOffset]$raw.startedAt -lt [DateTimeOffset]$Result.executionStartedAt -or [DateTimeOffset]$raw.endedAt -lt [DateTimeOffset]$raw.startedAt -or [DateTimeOffset]$raw.endedAt -gt ([DateTimeOffset]$Result.executionEndedAt).AddSeconds(1)){throw 'Unity execute-method raw completion invalid.'}
+    }else{
+        [xml]$raw=Get-Content (Resolve-GateArtifact $node $reports[0].path) -Raw -Encoding UTF8
+        if($binding.scope -ne 'all'){
+            foreach($case in $raw.SelectNodes("//*[local-name()='test-case']")){if(-not ([string]$case.fullname).Contains([string]$binding.scope)){throw 'Unity NUnit test filter scope mismatch.'}}
+        }
+        $assemblies=@($raw.SelectNodes("//*[local-name()='test-suite' and @type='Assembly']"))
+        $expected=@($trusted.assemblyPaths|ForEach-Object{[IO.Path]::GetFileNameWithoutExtension($_)})
+        $names=@($assemblies|ForEach-Object{[IO.Path]::GetFileNameWithoutExtension([string]$_.fullname)}|Sort-Object -Unique)
+        if(($names -join '|') -cne (@($expected|Sort-Object) -join '|')){throw 'Unity NUnit loaded assembly scope mismatch.'}
+        foreach($assembly in $assemblies){
+            $location=[string]$assembly.fullname
+            if(-not [IO.Path]::IsPathRooted($location) -or -not @($trusted.assemblyPaths|Where-Object{[IO.Path]::GetFullPath($_) -ieq [IO.Path]::GetFullPath($location)}).Count){throw 'Unity NUnit assembly path mismatch.'}
+        }
+    }
+}
+function Register-GateUnityChildProof {
+    param($Result,$Context,[string]$Version,[string]$Editor,[string[]]$Assemblies)
+    $proofs=@($Result.artifacts|Where-Object{$_.role -eq 'unity-build-proof'})
+    if($proofs.Count -ne 1){throw 'Unity child build proof absent.'}
+    $path=Resolve-GateArtifact $Context.nodeRoot $proofs[0].path
+    $proof=Assert-GateUnityBuildProof $path $Result $Version $Editor $Assemblies
+    if(-not $script:GateUnityValidation){$script:GateUnityValidation=@{}}
+    $script:GateUnityValidation[$Result.resultId]=@{version=$Version;editorPath=$Editor;assemblyPaths=$Assemblies;proofPath=$path;projectPath=$Proof.projectPath}
+    Assert-GateUnityEvidence $Result $Context.runRoot
+}
