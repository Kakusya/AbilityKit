+function Start-GateProducer {
+    param([string]$ContextPath,[string]$ResultPath,[string]$ScriptPath,[string]$TestAdapterPath,[System.Collections.IDictionary]$BoundParameters)
+    $script:GateNativeExecutor=$null
+    $script:GateAssertions=0
+    $script:GateAssertionEntries=New-Object 'System.Collections.Generic.List[object]'
+    $script:GateProducer=$null
+    if(-not $ContextPath){if($ResultPath -or $TestAdapterPath){throw 'Result/adapter requires invocation context.'};return}
+    $context=Get-Content -LiteralPath $ContextPath -Raw|ConvertFrom-Json
+    $node=[IO.Path]::GetFullPath($context.nodeRoot)
+    if($node -ne (Resolve-GateArtifact $context.runRoot $context.result.resultId) -or [IO.Path]::GetFullPath($ContextPath) -ne (Join-Path $node 'context.json')){throw 'Invocation node context mismatch.'}
+    if([IO.Path]::GetFullPath($ResultPath) -ne (Join-Path $node 'producer-result.json')){throw 'Producer result location mismatch.'}
+    if($context.result.example -ne $context.example){throw 'Context example contradiction.'}
+    if($context.PSObject.Properties['script']){
+        $expectedScriptPath=$(if([IO.Path]::IsPathRooted($context.script)){$context.script}else{Join-Path $context.repoRoot $context.script})
+        if([IO.Path]::GetFullPath($ScriptPath) -ne [IO.Path]::GetFullPath($expectedScriptPath)){throw 'Invocation script mismatch.'}
+    }
+    $script:GateProducer=[pscustomobject]@{context=$context;result=$context.result;resultPath=$ResultPath;scriptPath=$ScriptPath;completed=$false;inputs=@{}}
+    $script:GateProducer.result.startedAt=[DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')
+    $script:GateProducer.result.command=@{executable='powershell';arguments=@('-File',$ScriptPath)}
+    $script:GateProducer.result.executionStartedAt=[DateTimeOffset]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ')
+    $script:GateProducer.result.tools=@(@{name='PowerShell';version=$PSVersionTable.PSVersion.ToString()})
+    $externalBodies=@('check_sample_baseline.ps1','moba_business_id.tests.ps1','build_moba_content_report.tests.ps1','run_runtime_benchmarks.ps1','run_shooter_aoi_lod_gate.ps1','run-unity-compile-check.ps1')
+    if($context.example -and -not $TestAdapterPath -and [IO.Path]::GetFileName($ScriptPath) -in $externalBodies){throw 'External-work fixture requires entry interception.'}
+    if($null -ne $BoundParameters){
+        $arguments=@($context.arguments)
+        for($index=0;$index -lt $arguments.Count;$index++){
+            $name=([string]$arguments[$index]).TrimStart('-')
+            if(-not $name -or $name -notin $BoundParameters.Keys){throw "Configured parameter missing: $name"}
+            $expected=$true
+            if($index+1 -lt $arguments.Count -and ([string]$arguments[$index+1]) -notmatch '^-'){$index++;$expected=([string]$arguments[$index]).Replace('{GateOutputDirectory}',$context.nodeRoot).Replace('{Configuration}',$context.configuration)}
+            $actual=$BoundParameters[$name]
+            if($expected -is [bool]){if(-not [bool]$actual){throw "Configured switch mismatch: $name"}}
+            elseif((@($actual) -join ',') -cne $expected){throw "Configured parameter mismatch: $name"}
+        }
+        $bindingPath=Join-Path $node 'invocation-contract.json'
+        @{script=$context.script;arguments=$arguments;configuration=$context.configuration;actualParameters=$BoundParameters}|ConvertTo-Json -Depth 12|Set-Content $bindingPath -Encoding UTF8
+        Add-GateArtifact $script:GateProducer.result $context.runRoot $bindingPath 'invocation-contract'
+        $script:GateProducer.result.command.arguments+=@($arguments|ForEach-Object{([string]$_).Replace('{GateOutputDirectory}',$context.nodeRoot).Replace('{Configuration}',$context.configuration)})
+    }
+    if($TestAdapterPath){
+        if(-not $context.example){throw 'Production rejects fixture adapter.'}
+        $allowed=Join-Path $context.repoRoot 'tools/tests/fixtures'
+        $relative=[IO.Path]::GetFullPath($TestAdapterPath).Substring([IO.Path]::GetFullPath($allowed).TrimEnd('\','/').Length+1).Replace('\','/')
+        if((Resolve-GateArtifact $allowed $relative) -ne [IO.Path]::GetFullPath($TestAdapterPath)){throw 'Adapter outside fixture directory.'}
+        # Entry seam runs before the original body imports process helpers or probes ports.
+        . $TestAdapterPath
+        Install-GateProducerFixture $script:GateProducer $ScriptPath
+    }
+    if($context.example -and [IO.Path]::GetFileName($ScriptPath) -in $externalBodies -and -not $script:GateNativeExecutor){throw 'Fixture entry did not install its native executor.'}
+    Assert-GateSource $context.source (Get-GateSource $context.repoRoot)
+}
