+function Use-GateProducerInput {
+    param([string]$Path)
+    if(-not $script:GateProducer){return}
+    $producer=$script:GateProducer;$full=[IO.Path]::GetFullPath($Path)
+    if($producer.inputs.ContainsKey($full)){return}
+    $hash=Get-GateHash $full -AllowEmptyImmutableInput
+    $directory=Join-Path $producer.context.nodeRoot 'inputs';$null=New-Item -ItemType Directory $directory -Force
+    $copy=Join-Path $directory ('input-'+$producer.inputs.Count+'.input')
+    Copy-Item -LiteralPath $full -Destination $copy
+    $artifact=New-GateBuildArtifact $producer.context.nodeRoot $copy 'immutable-input' $producer.result.runId $producer.result.resultId
+    if($artifact.sha256 -ne $hash){throw 'Input changed while archiving.'}
+    $producer.inputs[$full]=@{path=$full;sha256=$hash;artifact=$artifact}
+}
