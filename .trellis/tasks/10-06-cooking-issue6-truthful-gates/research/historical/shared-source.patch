+    foreach($entry in $entries){
+        if(-not $entry.id -or $seen.ContainsKey($entry.id)){throw 'Assertion IDs absent or duplicated.'};$seen[$entry.id]=$true
+        switch($entry.outcome){'Passed'{$passed++};'Failed'{$failed++};default{throw 'Unknown assertion outcome.'}}
+    }
+    return [pscustomobject]@{declared=$true;total=$entries.Count;resultEntries=$entries.Count;executed=$entries.Count;passed=$passed;failed=$failed;skipped=0;notExecuted=0}
