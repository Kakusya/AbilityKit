+function Assert-GateProducerEvidence {
+    param($Result,$Context)
+    if($Context.evidenceType -in @('measurement','thresholds')){Assert-GateBenchmarkEvidence $Result $Context}
+    if([IO.Path]::GetFileName($Context.script) -ceq 'run-unity-compile-check.ps1'){Assert-GateUnityEvidence $Result $Context.runRoot}
+    foreach($manifest in @($Result.artifacts|Where-Object{$_.role -eq 'producer-inputs'})){
+        $inputs=Get-Content (Resolve-GateArtifact $Context.nodeRoot $manifest.path) -Raw -Encoding UTF8|ConvertFrom-Json
+        $seen=@{}
+        foreach($input in $inputs){
+            if($seen.ContainsKey($input.path)){throw 'Duplicate producer input.'};$seen[$input.path]=$true
+            $null=Assert-GateBuildArtifact $input.artifact $Context.nodeRoot $Result.runId $Result.resultId -AllowBoundImmutableInput
+            if($input.sha256 -ne $input.artifact.sha256 -or (Get-GateHash $input.path -AllowEmptyImmutableInput) -ne $input.sha256){throw 'Producer input binding changed.'}
+        }
+    }
+    if($Context.evidenceType -eq 'audit'){
+        $raw=@($Result.artifacts|Where-Object{$_.role -eq 'audit-assertions'})
+        if($raw.Count -ne 1){throw 'Current audit criteria absent.'}
+        Assert-GateTests (Get-GateAssertionCounts (Resolve-GateArtifact $Context.nodeRoot $raw[0].path))
+        if([IO.Path]::GetFileName($Context.script) -eq 'check_sample_baseline.ps1'){
+            $baseline=@($Result.artifacts|Where-Object{$_.role -eq 'sample-baseline'})
+            $captures=@($Result.artifacts|Where-Object{$_.role -eq 'sample-capture'})
+            if($baseline.Count -ne 1 -or $captures.Count -notin @(1,2) -or -not @($Result.artifacts|Where-Object{$_.role -eq 'sample-raw'}).Count){throw 'Golden baseline raw evidence absent.'}
+            $expected=[IO.File]::ReadAllText((Resolve-GateArtifact $Context.nodeRoot $baseline[0].path),[Text.Encoding]::UTF8).TrimStart([char]0xfeff).Replace("`r`n","`n").Replace("`r","`n")
+            $matched=$false
+            foreach($capture in $captures){$actual=[IO.File]::ReadAllText((Resolve-GateArtifact $Context.nodeRoot $capture.path),[Text.Encoding]::UTF8);if($actual -ceq $expected){$matched=$true}}
+            if(-not $matched){throw 'No normalized sample capture matches the bound golden baseline.'}
+        }
+    }
+    if($Context.evidenceType -eq 'report'){
+        $scriptName=[IO.Path]::GetFileName($Context.script)
+        $roles=switch($scriptName){
+            'build_moba_content_report.ps1' {@('content-report')}
+            'export_moba_content_ir.ps1' {@('content-ir','content-diagnostics')}
+            'build_moba_content_graph.ps1' {@('content-html','content-dot')}
+            default {throw 'Unspecified report evidence contract.'}
+        }
+        foreach($role in $roles){
+            $artifacts=@($Result.artifacts|Where-Object{$_.role -eq $role})
+            if($artifacts.Count -ne 1){throw "Exact report output missing: $role"}
+            $path=Resolve-GateArtifact $Context.nodeRoot $artifacts[0].path;$null=Get-GateHash $path
+            switch($role){
+                'content-report' {
+                    $r=Get-Content $path -Raw -Encoding UTF8|ConvertFrom-Json
+                    if($r.schemaVersion -ne 1 -or $r.report -cne 'moba-content-dependency' -or $r.status -cne 'passed' -or @($r.tables).Count -le 0 -or $r.summary.tables -ne @($r.tables).Count -or $r.summary.edges -ne @($r.edges).Count -or $r.summary.errors -ne @($r.issues|Where-Object{$_.severity -eq 'error'}).Count -or $r.summary.errors -ne 0){throw 'Content dependency report contract failed.'}
+                }
+                'content-ir' {
+                    $r=Get-Content $path -Raw -Encoding UTF8|ConvertFrom-Json
+                    if($r.schemaVersion -ne 1 -or $r.graph -cne 'moba-content-graph' -or $r.status -cne 'passed' -or @($r.nodes).Count -le 0 -or $r.summary.nodes -ne @($r.nodes).Count -or $r.summary.edges -ne @($r.edges).Count -or @($r.nodes.id|Sort-Object -Unique).Count -ne @($r.nodes).Count){throw 'Content IR contract failed.'}
+                    foreach($edge in $r.edges){if($edge.source -notin $r.nodes.id -or $edge.target -notin $r.nodes.id){throw 'IR edge endpoint absent.'}}
+                }
+                'content-diagnostics' {
+                    $r=Get-Content $path -Raw -Encoding UTF8|ConvertFrom-Json
+                    if($r.schemaVersion -ne 1 -or $r.diagnostics -cne 'moba-content-diagnostics' -or $r.status -cne 'passed' -or $r.summary.total -ne @($r.items).Count -or $r.summary.errors -ne @($r.items|Where-Object{$_.severity -eq 'error'}).Count -or $r.summary.errors -ne 0){throw 'Content diagnostics contract failed.'}
+                }
+                'content-html' {if((Get-Content $path -Raw -Encoding UTF8) -notmatch '(?i)<!doctype html>|<html'){throw 'HTML output invalid.'}}
+                'content-dot' {if((Get-Content $path -Raw -Encoding UTF8) -notmatch 'digraph'){throw 'DOT output invalid.'}}
+            }
+        }
+        if($scriptName -ne 'build_moba_content_report.ps1'){
+            $bindings=@($Result.artifacts|Where-Object{$_.role -eq 'predecessor-bindings'})
+            if($bindings.Count -ne 1){throw 'Report predecessor bindings missing.'}
+            $actual=Get-Content (Resolve-GateArtifact $Context.nodeRoot $bindings[0].path) -Raw -Encoding UTF8|ConvertFrom-Json
+            if((ConvertTo-Json -InputObject @($actual) -Depth 20 -Compress) -cne (ConvertTo-Json -InputObject @($Context.predecessors) -Depth 20 -Compress)){throw 'Report predecessor context mismatch.'}
+            foreach($entry in $Context.predecessors){
+                $path=Resolve-GateArtifact (Join-Path $Context.runRoot $entry.result.resultId) $entry.artifact.path
+                if((Get-GateHash $path) -ne $entry.artifact.sha256){throw 'Predecessor changed after use.'}
+            }
+        }
+    }
+}
