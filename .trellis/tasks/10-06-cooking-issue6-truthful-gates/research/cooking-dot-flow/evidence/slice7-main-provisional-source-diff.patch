     [IO.File]::WriteAllText((Join-Path $directory 'candidate.json'),(ConvertTo-GateJson $candidate))
-    $ctx=[pscustomobject]@{runRoot=$seed.runRoot; allowExample=$AllowExample; control=$reuseFixture.context; abortStatus=$null}
